---
import "../assets/css/style.css";

import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {

    title?: string;

    description?: string;

}

const {

    title = "Support Engineering Blog",

    description = "Technical documentation, Microsoft 365 administration, and support engineering resources."

} = Astro.props;
---

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>

    <meta
        name="description"
        content={description}
    />

    <link
        rel="icon"
        href="/favicon/favicon.ico"
    />

</head>

<body>

    <Header />

    <slot />

    <Footer />

</body>

</html>