---
import "../assets/css/style.css";

import { site } from "../config/site";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {

    title?: string;

    description?: string;

}

const {

    title = "Support Engineering Blog",

    description = "Technical documentation, Microsoft 365 administration, and support engineering resources."

} = Astro.props;
---

<!doctype html>

<html lang="en">

    <head>

        <meta charset="UTF-8" />

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />

        <title>{title}</title>

        <meta
            name="description"
            content={description}
        />

        <meta
            name="author"
            content={site.author}
        />

        <meta
            name="robots"
            content="index, follow"
        />

        <meta
            name="theme-color"
            content={site.themeColor}
        />

        <link
            rel="canonical"
            href={Astro.url.href}
        />

        <link
            rel="icon"
            href="/favicon/favicon.ico"
        />

    </head>

    <body>

        <a
            href="#main-content"
            class="skip-link"
        >

            Skip to main content

        </a>

        <Header />

        <slot />

        <Footer />

        <script type="module">

            import {
                initializeGlobalSearch
            } from "../scripts/global-search";

            initializeGlobalSearch();

        </script>

    </body>

</html>