---
/* ==========================================================
   SEDS — Article Layout
   ----------------------------------------------------------
   Purpose:
   Provides the shared structure for individual articles,
   including article metadata, Reader's Toolkit, content,
   references, and related articles.

   SEO metadata is passed to BaseLayout, while the article
   content itself remains independent of the document shell.
   ========================================================== */

import BaseLayout from "./BaseLayout.astro";

import Container from "../components/layout/Container.astro";

import ArticleSidebar from "../components/article/ArticleSidebar.astro";
import QuickSummary from "../components/article/widgets/QuickSummary.astro";
import TechnologyStack from "../components/article/TechnologyStack.astro";
import References from "../components/article/References.astro";
import RelatedArticles from "../components/article/RelatedArticles.astro";

import { slugify } from "../utils/slug";


/* ==========================================================
   Heading Type
   ----------------------------------------------------------
   Used by the Reader's Toolkit / Table of Contents.
   ========================================================== */

interface Heading {

    depth: number;

    slug: string;

    text: string;

}


/* ==========================================================
   Article Layout Props
   ========================================================== */

interface Props {

    /* ------------------------------------------------------
       Primary article metadata
       ------------------------------------------------------ */

    title: string;

    description: string;

    category: string;

    readingTime: string;

    updated: string;

    socialImage?: string;


    /* ------------------------------------------------------
       Machine-readable publication metadata
       Used by BaseLayout for SEO / Open Graph.
       ------------------------------------------------------ */

    publishDate: Date;

    updatedDate?: Date;

    author: string;


    /* ------------------------------------------------------
       Article content
       ------------------------------------------------------ */

    summary?: string[];

    headings?: Heading[];

    technology?: string[];


    /* ------------------------------------------------------
       References
       ------------------------------------------------------ */

    references?: {

        title: string;

        url: string;

        description: string;

    }[];


    /* ------------------------------------------------------
       Related articles
       ------------------------------------------------------ */

    relatedArticles?: {

        id: string;

        data: {

            title: string;

        };

        readingTime: string;

    }[];

}


/* ==========================================================
   Props
   ========================================================== */

const {

    title,

    description,

    category,

    readingTime,

    updated,

    publishDate,

    updatedDate,

    socialImage,

    author,

    summary,

    headings = [],

    technology,

    references = [],

    relatedArticles = []

} = Astro.props;

---

<BaseLayout

    title={title}

    description={description}

    type="article"

    publishedTime={publishDate}

    modifiedTime={updatedDate}

    section={category}

    author={author}

    socialImage={socialImage}

>

    <main

        id="main-content"

        class="article-page"

    >

        <Container>


            <!-- ==================================================
                 Article Header
                 ================================================== -->

            <header class="article-header">


                <!-- ==================================================
                     Pagefind Metadata
                     --------------------------------------------------
                     These hidden elements provide structured metadata
                     for the client-side Pagefind search index.
                     ================================================== -->

                <span
                    hidden
                    data-pagefind-meta="category"
                >

                    {category}

                </span>


                <span
                    hidden
                    data-pagefind-meta="reading_time"
                >

                    {readingTime}

                </span>


                <span
                    hidden
                    data-pagefind-meta="description"
                >

                    {description}

                </span>


                <!-- ==================================================
                     Article Category
                     ================================================== -->

                <a
                    href={`/category/${slugify(category)}`}
                    class="article-category"
                    aria-label={`View all articles in the ${category} category`}
                >

                    {category}

                </a>


                <!-- ==================================================
                     Article Title
                     ================================================== -->

                <h1>

                    {title}

                </h1>


                <!-- ==================================================
                     Article Description
                     ================================================== -->

                <p class="article-description">

                    {description}

                </p>


                <!-- ==================================================
                     Technology Stack
                     ================================================== -->

                <TechnologyStack

                    technology={technology}

                />

            </header>


            <!-- ==================================================
                 Article Layout
                 --------------------------------------------------
                 Desktop:
                 Reader's Toolkit occupies the left column.

                 Mobile / Tablet:
                 Desktop sidebar is hidden and the mobile
                 Reader's Toolkit is displayed within the article.
                 ================================================== -->

            <div class="article-layout">


                <!-- ==================================================
                     Desktop Reader's Toolkit
                     ================================================== -->

                <div class="article-sidebar--desktop">

                    <ArticleSidebar

                        category={category}

                        readingTime={readingTime}

                        updated={updated}

                        headings={headings}

                    />

                </div>


                <!-- ==================================================
                     Main Article Content
                     ================================================== -->

                <article

                    class="article-content"

                    data-pagefind-body

                >


                    <!-- ==================================================
                         Key Takeaways
                         ================================================== -->

                    <QuickSummary

                        summary={summary}

                    />


                    <!-- ==================================================
                         Mobile Reader's Toolkit
                         ================================================== -->

                    <div class="article-sidebar--mobile">

                        <ArticleSidebar

                            category={category}

                            readingTime={readingTime}

                            updated={updated}

                            headings={headings}

                        />

                    </div>


                    <!-- ==================================================
                         Article Body
                         --------------------------------------------------
                         The individual Markdown article is rendered
                         into this slot.
                         ================================================== -->

                    <slot />


                    <!-- ==================================================
                         References
                         ================================================== -->

                    <References

                        references={references}

                    />


                    <!-- ==================================================
                         Related Articles
                         --------------------------------------------------
                         Excluded from Pagefind indexing so related
                         content does not interfere with search
                         results for the current article.
                         ================================================== -->

                    <div data-pagefind-ignore>

                        <RelatedArticles

                            articles={relatedArticles}

                        />

                    </div>

                </article>

            </div>

        </Container>

    </main>

</BaseLayout>