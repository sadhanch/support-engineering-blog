---
import BaseLayout from "./BaseLayout.astro";

import Container from "../components/layout/Container.astro";
import ArticleSidebar from "../components/article/ArticleSidebar.astro";
import QuickSummary from "../components/article/widgets/QuickSummary.astro";
import TechnologyStack from "../components/article/TechnologyStack.astro";
import References from "../components/article/References.astro";
import RelatedArticles from "../components/article/RelatedArticles.astro";

import { slugify } from "../utils/slug";

interface Heading {

    depth: number;

    slug: string;

    text: string;

}

interface Props {

    title: string;

    description: string;

    category: string;

    readingTime: string;

    updated: string;

    summary?: string[];

    headings?: Heading[];

    technology?: string[];

    references?: {

        title: string;

        url: string;

        description: string;

    }[];

    relatedArticles?: {

        id: string;

        data: {

            title: string;

        };

        readingTime: string;

    }[];

}

const {

    title,

    description,

    category,

    readingTime,

    updated,

    summary,

    headings = [],

    technology,

    references = [],

    relatedArticles = [],

} = Astro.props;
---

<BaseLayout

    title={title}

    description={description}

>

    <main

        id="main-content"

        class="article-page"

    >

        <Container>

            <header class="article-header">

                <span
                    hidden
                    data-pagefind-meta="category"
                >

                    {category}

                </span>

                <span
                    hidden
                    data-pagefind-meta="reading_time"
                >

                    {readingTime}

                </span>

                <span
                    hidden
                    data-pagefind-meta="description"
                >
                    {description}
                </span>

                <a
                    href={`/category/${slugify(category)}`}
                    class="article-category"
                    aria-label={`View all articles in the ${category} category`}
                >

                    {category}

                </a>

                <h1>

                    {title}

                </h1>

                <p class="article-description">

                    {description}

                </p>

                <TechnologyStack

                    technology={technology}

                />

            </header>

            <div class="article-layout">

                <div class="article-sidebar--desktop">

                    <ArticleSidebar

                        category={category}

                        readingTime={readingTime}

                        updated={updated}

                        headings={headings}

                    />

                </div>

                <article
                    class="article-content"
                    data-pagefind-body
                >

                    <QuickSummary

                        summary={summary}

                    />

                    <div class="article-sidebar--mobile">

                        <ArticleSidebar

                            category={category}

                            readingTime={readingTime}

                            updated={updated}

                            headings={headings}

                        />

                    </div>

                    <slot />

                    <References

                        references={references}

                    />

                    <div data-pagefind-ignore>

                        <RelatedArticles

                            articles={relatedArticles}

                        />

                    </div>

                </article>

            </div>

        </Container>

    </main>

</BaseLayout>