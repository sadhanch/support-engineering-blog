<!-- ==========================================================
     SEDS — Support Engineering Design System

     Component  : Global Site Header
     File       : header.xml
     Version    : 1.0.0
     Status     : Stable

     Purpose
     -------
     Displays the global site header including the blog
     title, optional description, and primary navigation.

     Depends On
     ----------
     navigation.xml (Future)

     Used By
     -------
     Homepage
     Article
     Search
     Archive
========================================================== -->

<header class='site-header' role='banner'>

    <div class='container'>

        <!-- ==================================================
             Site Branding
        =================================================== -->

        <div class='site-branding'>

            <a
                class='site-title'
                expr:href='data:blog.homepageUrl'>

                <data:blog.title/>

            </a>

            <b:if cond='data:blog.description'>

                <p class='site-description'>

                    <data:blog.description/>

                </p>

            </b:if>

        </div>

                <!-- ==================================================
             Primary Navigation
        =================================================== -->

        {{NAVIGATION}}

    </div>

</header>

<!-- ==========================================================
     Future Enhancements

     • Sticky Header
     • Search
     • Theme Switcher
     • Announcement Banner
========================================================== -->