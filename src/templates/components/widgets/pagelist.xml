<?xml version="1.0" encoding="UTF-8"?>

<!--
============================================================
SEDS Widget
============================================================

Widget Name : PageList
Blogger Type: PageList

Purpose
-------
Render Blogger Pages using the SEDS navigation system.

Ownership
---------
Blogger
  • Page data
  • URLs
  • Active page state
  • Page ordering

SEDS
  • HTML structure
  • CSS classes
  • Accessibility
  • Responsive presentation

============================================================
-->

<!-- ======================================================
     Main Entry Point
====================================================== -->

<b:includable id='main'>

  <b:include name='content'/>

</b:includable>

<!-- ======================================================
     Widget Content
====================================================== -->

<b:includable id='content'>

  <b:if cond='data:links'>

    <nav class='seds-navigation'
         data-widget='pagelist'
         aria-label='Primary navigation'>

      <ul class='seds-navigation__list'>

        <b:include name='pageList'/>

      </ul>

    </nav>

  </b:if>

</b:includable>

<!-- ======================================================
     Page Collection
====================================================== -->

<b:includable id='pageList'>

  <b:loop values='data:links' var='link'>

    <b:include name='pageLink'/>

  </b:loop>

</b:includable>

<!-- ======================================================
     Individual Page
====================================================== -->

<b:includable id='pageLink'>

  <li class='seds-navigation__item'>

    <b:class cond='data:link.isCurrentPage'
             name='seds-navigation__item--active'/>

    <a class='seds-navigation__link'
        expr:href='data:link.href'>

      <b:if cond='data:link.isCurrentPage'>
        <b:attr name='aria-current'
                value='page'/>
      </b:if>

      <data:link.name/>

    </a>

  </li>

</b:includable>

<!-- ======================================================
     Overflow Navigation
====================================================== -->

<b:includable id='overflowButton'>

  <!--
  Reserved for future responsive navigation.

  SEDS v0.3.0 intentionally preserves this includable
  to maintain Blogger's widget contract.
  -->

</b:includable>