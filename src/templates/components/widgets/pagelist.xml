<?xml version="1.0" encoding="UTF-8"?>

<!--
============================================================
SEDS Widget
============================================================

Widget Name : PageList
Blogger Type: PageList

Purpose
-------
Render Blogger Pages using the SEDS navigation system.

Ownership
---------
Blogger
  • Page data
  • URLs
  • Active page state
  • Page ordering

SEDS
  • HTML structure
  • CSS classes
  • Accessibility
  • Responsive presentation

============================================================
-->

<!-- ======================================================
     Main Entry Point
====================================================== -->

<b:includable id='main'>

  <!--
    The main includable is the widget entry point.

    It intentionally delegates all rendering to the
    content includable.

    Keeping this orchestration separate allows the
    rendering pipeline to remain modular and mirrors
    Blogger's native widget lifecycle.
  -->

  <b:include name='content'/>

</b:includable>

<!-- ======================================================
     Widget Content
====================================================== -->

<b:includable id='content'>

  <!--
    SEDS provides the semantic navigation container while
    Blogger continues to own the navigation data.

    Rendering of the individual navigation items is delegated
    to the pageList includable.
  -->

  <nav class='seds-navigation'
       aria-label='Primary navigation'>

    <ul class='seds-navigation__list'>

      <b:include name='pageList'/>

    </ul>

  </nav>

</b:includable>

<!-- ======================================================
     Page Collection
====================================================== -->

<b:includable id='pageList'>

  <!--
    Blogger owns the page collection.

    SEDS simply iterates over the supplied data and delegates
    rendering of each navigation item to pageLink.
  -->

  <b:loop values='data:links' var='link'>
    <b:include name='pageLink' data='link'/>
  </b:loop>

</b:includable>

<!-- ======================================================
     Individual Page
====================================================== -->

<b:includable id='pageLink' var='link'>

  <!--
    Render a single navigation item.

    Active state is determined exclusively by Blogger through
    data:link.isCurrentPage.
  -->

  <li class='seds-navigation__item'>

    <a expr:href='data:link.target'
       expr:class='data:link.isCurrentPage ?
         "seds-navigation__link seds-navigation__link--active" :
         "seds-navigation__link"'>

      <data:link.name/>

    </a>

  </li>

</b:includable>

<!-- ======================================================
     Overflow Navigation
====================================================== -->

<b:includable id='overflowButton'>
    <!-- Responsive overflow -->
</b:includable>