---
/* ==========================================================
   SEDS — Key Takeaways
   ----------------------------------------------------------
   Purpose:
   Presents a short summary of the most important points
   before the main article content.

   Used By:
   ArticleLayout.astro
   ========================================================== */

interface Props {

    summary?: string[];

}

const {

    summary = []

} = Astro.props;

if (summary.length === 0) {

    return;

}
---

<section class="key-takeaways">

    <header class="key-takeaways__header">

        <h2>

            Key Takeaways

        </h2>

    </header>

    <ul>

        {

            summary.map((item) => (

                <li>

                    {item}

                </li>

            ))

        }

    </ul>

</section>