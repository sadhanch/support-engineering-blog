<div class="reading-progress">

    <div class="reading-progress__header">

        <span>

            Reading Progress

        </span>

        <span id="reading-progress-percentage">

            0%

        </span>

    </div>

    <div class="reading-progress__track">

        <div

            id="reading-progress-bar"

            class="reading-progress__bar"

        ></div>

    </div>

</div>

<script>

    const progressBar = document.getElementById(
        "reading-progress-bar"
    );

    const percentage = document.getElementById(
        "reading-progress-percentage"
    );

    function updateProgress() {

        const documentHeight =
            document.documentElement.scrollHeight -
            window.innerHeight;

        const progress =
            documentHeight > 0
                ? (window.scrollY / documentHeight) * 100
                : 0;

        const value = Math.min(
            100,
            Math.max(0, progress)
        );

        if (progressBar instanceof HTMLElement) {

            progressBar.style.width = `${value}%`;

        }

        if (percentage instanceof HTMLElement) {

            percentage.textContent =
                `${Math.round(value)}%`;

        }

    }

    updateProgress();

    window.addEventListener(
        "scroll",
        updateProgress,
        {
            passive: true
        }
    );

</script>