---
/* ==========================================================
   SEDS — Article Sidebar
   Purpose: Reader's Toolkit container focused on navigation.
   ========================================================== */

import NavigationPanel from "./NavigationPanel.astro";

interface Heading {

    depth: number;

    slug: string;

    text: string;

}

interface Props {

    headings?: Heading[];

}

const {

    headings = []

} = Astro.props;
---

<aside class="article-sidebar">

    <NavigationPanel

        headings={headings}

    />

</aside>
