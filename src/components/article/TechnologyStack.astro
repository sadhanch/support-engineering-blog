---
import Badge from "../ui/Badge.astro";

import { slugify } from "../../utils/slug";

interface Props {

    technology: string[];

}

const {

    technology

} = Astro.props;
---

{

    technology.length > 0 && (

        <section class="technology-stack">

            <h2 class="technology-stack__title">

                Technology

            </h2>

            <div class="technology-stack__badges">

                {

                    technology.map((item) => (

                        <a

                            href={`/technology/${slugify(item)}`}

                            class="technology-stack__link"

                            aria-label={`View all articles about ${item}`}

                        >

                            <Badge>

                                {item}

                            </Badge>

                        </a>

                    ))

                }

            </div>

        </section>

    )

}