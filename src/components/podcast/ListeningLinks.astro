---
/**
 * ==========================================================
 * Support Engineering Weekly — Listening Links
 * ==========================================================
 *
 * Purpose:
 * Presents the podcast platforms that are currently available
 * to listeners.
 *
 * Platform data is supplied by the central podcast configuration.
 * ==========================================================
 */

import { podcast } from "../../config/podcast";
---

<div
    class="podcast-listening"
    aria-label="Listen to Support Engineering Weekly"
>

    <div class="podcast-listening__links">

        {

            podcast.listen.live.map((platform) => (

                <a
                    href={platform.url}
                    class="podcast-listening__link"
                    target="_blank"
                    rel="noopener noreferrer"
                >

                    <span class="podcast-listening__name">
                        {platform.name}
                    </span>

                    <span class="podcast-listening__action">
                        Listen →
                    </span>

                </a>

            ))

        }

    </div>

</div>