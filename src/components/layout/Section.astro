---
/* ==========================================================
   SEDS — Section
   Purpose: Provides reusable vertical section spacing and optional section attributes.
   ========================================================== */

interface Props {
    id?: string;
    class?: string;
}

const {
    id,
    class: className = ""
} = Astro.props;
---

<section
    id={id}
    class:list={["section", className]}
>
    <slot />
</section>