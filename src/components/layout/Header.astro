---
/* ==========================================================
SEDS — Global Header
Purpose: Renders site branding, primary navigation, and global search.
========================================================== */

import { site } from "../../config/site";
import SearchButton from "../ui/SearchButton.astro";
---

<div class="header-container">

    <a
    href="/"
    class="site-logo"
    aria-label={site.title}
    >

        <img
            src="/logo/logo-black.svg"
            alt=""
            class="site-logo__image site-logo__image--black"
            aria-hidden="true"
        />

        <img
            src="/logo/logo-light.svg"
            alt=""
            class="site-logo__image site-logo__image--light"
            aria-hidden="true"
        />

        <img
            src="/logo/logo-color.svg"
            alt=""
            class="site-logo__image site-logo__image--color"
            aria-hidden="true"
        />

        <span class="site-logo__mobile">
            {site.shortTitle}
        </span>

    </a>

    <nav aria-label="Primary Navigation">

        <ul class="site-navigation">

            {
                site.navigation.map((item) => (

                    <li>

                        <a href={item.href}>

                            {item.label}

                        </a>

                    </li>

                ))
            }

        </ul>

    </nav>

    <SearchButton />

    <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Change color theme"
        title="Change color theme"
    >
        <span
            class="theme-toggle__icon"
            aria-hidden="true"
        >
            ◐
        </span>
    </button>

</div>