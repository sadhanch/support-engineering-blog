---
/**
 * ==========================================================
 * SEDS — Homepage Categories Section
 * Purpose: Displays featured categories using editorial
 * category configuration and live published article counts.
 * ==========================================================
 */

import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";

import CategoryCard from "../ui/CategoryCard.astro";

import SectionHeader from "../ui/SectionHeader.astro";

import { getFeaturedCategories } from "../../lib/categories";

const categories = await getFeaturedCategories();
---

<Container>

    <SectionHeader

        title="Categories"

        description="Browse articles organized by Microsoft technologies and engineering disciplines."

    />

    <div class="category-grid">

        {

            categories.map((category) => (

                <CategoryCard

                    title={category.name}

                    description={category.description}

                    href={`/category/${category.slug}`}

                    articleCount={category.count}

                />

            ))

        }

    </div>

</Container>