---
import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import Button from "../ui/Button.astro";
---

<Section>

    <Container>

        <div class="hero">

            <div class="hero-content">

                <p class="hero-eyebrow">
                    SUPPORT ENGINEERING BLOG
                </p>

                <h1 class="hero-title">
                    Practical guides for Microsoft 365 administrators and support engineers.
                </h1>

                <p class="hero-description">
                    Deep technical articles, troubleshooting guides, architecture insights,
                    and engineering best practices—written to help you solve real-world
                    Microsoft 365 problems.
                </p>

                <div class="hero-actions">

                    <Button href="/articles">
                        Browse Articles
                    </Button>

                    <Button
                        href="/about"
                        variant="outline"
                    >
                        About the Project
                    </Button>

                </div>

            </div>

        </div>

    </Container>

</Section>