---
/* ==========================================================
   SEDS — Metadata Item
   Purpose: Individual metadata value, optionally linked.
   ========================================================== */

interface Props {

    label: string;

    href?: string;

}

const {

    label,

    href

} = Astro.props;
---

<span class="metadata__item">

    {

        href ? (

            <a

                href={href}

                class="metadata__link"

            >

                {label}

            </a>

        ) : (

            label

        )

    }

</span>