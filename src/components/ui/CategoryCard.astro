---
/**
 * ==========================================================
 * SEDS — Category Card
 * Purpose: Displays a homepage category with its description,
 * published article count, and navigation destination.
 * ==========================================================
 */

interface Props {

    href: string;

    title: string;

    description: string;

    articleCount: number;

}

const {

    href,

    title,

    description,

    articleCount

} = Astro.props;
---

<a
    href={href}
    class="category-card"
>

    <!-- ==================================================
         Category Title
         ================================================== -->

    <h3 class="category-card__title">

        {title}

    </h3>


    <!-- ==================================================
         Category Description
         ================================================== -->

    <p class="category-card__description">

        {description}

    </p>


    <!-- ==================================================
         Category Metadata and Navigation
         ================================================== -->

    <div class="category-card__footer">

        <span class="category-card__count">

            {articleCount} Articles

        </span>

        <span class="category-card__link">

            Browse →

        </span>

    </div>

</a>