---
/* ==========================================================
   SEDS — Badge
   Purpose: Small reusable status/category label.
   ========================================================== */

interface Props {

    variant?: "default" | "success" | "info" | "warning";

}

const {

    variant = "default"

} = Astro.props;
---

<span class:list={["badge", `badge--${variant}`]}>

    <slot />

</span>