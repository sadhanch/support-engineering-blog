---
/* ==========================================================
   SEDS — Article Card
   Purpose: Reusable article preview card used by the homepage.
   ========================================================== */

import Card from "./Card.astro";
import Metadata from "../ui/metadata/Metadata.astro";

interface Props {

    href: string;

    category: string;

    title: string;

    description: string;

    readingTime: string;

    updated: string;

}

const {

    href,

    category,

    title,

    description,

    readingTime,

    updated

} = Astro.props;
---

<Card
    href={href}
    class="article-card"
>

    <Metadata

        category={category}

        readingTime={readingTime}

        updated={updated}

    />

    <h3 class="article-card__title">

        {title}

    </h3>

    <p class="article-card__description">

        {description}

    </p>

</Card>