---
/**
 * ==========================================================
 * SEDS — Learning Path Card
 * Purpose: Homepage and directory card for a Learning Path.
 * ==========================================================
 */

import Badge from "./Badge.astro";

interface Props {

    title: string;

    description: string;

    level: "Beginner" | "Intermediate" | "Advanced";

    articles: number;

    readingTime: string;

    href: string;

}

const {

    title,

    description,

    level,

    articles,

    readingTime,

    href

} = Astro.props;


const badgeVariant =

    level === "Beginner"

        ? "success"

        : level === "Intermediate"

            ? "info"

            : "warning";

---

<a

    href={href}

    class="learning-path-card"

>

    <!-- ==================================================
         Learning Path Metadata
         ================================================== -->

    <div class="learning-path-card__meta">

        <Badge variant={badgeVariant}>

            {level}

        </Badge>

        <span>

            {readingTime}

        </span>

    </div>


    <!-- ==================================================
         Learning Path Title
         ================================================== -->

    <h3>

        {title}

    </h3>


    <!-- ==================================================
         Learning Path Description
         ================================================== -->

    <p>

        {description}

    </p>


    <!-- ==================================================
         Learning Path Summary
         ================================================== -->

    <div class="learning-path-card__footer">

        <span>

            {articles}
            {articles === 1 ? " Article" : " Articles"}

        </span>

        <span>

            Start Learning →

        </span>

    </div>

</a>