---
interface Props {
    href?: string;
    class?: string;
}

const {
    href,
    class: className = ""
} = Astro.props;
---

{
    href ? (

        <a
            href={href}
            class:list={["card", className]}
        >
            <slot />
        </a>

    ) : (

        <div
            class:list={["card", className]}
        >
            <slot />
        </div>

    )
}