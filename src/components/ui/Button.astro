---
interface Props {
    href?: string;

    variant?: "primary" | "secondary" | "outline" | "ghost";

    size?: "sm" | "md" | "lg";

    fullWidth?: boolean;

    disabled?: boolean;

    type?: "button" | "submit" | "reset";
}

const {

    href,

    variant = "primary",

    size = "md",

    fullWidth = false,

    disabled = false,

    type = "button"

} = Astro.props;

const className = [
    "button",
    `button--${variant}`,
    `button--${size}`,
    fullWidth && "button--full",
]
.filter(Boolean)
.join(" ");
---

{
    href ? (

        <a
            href={href}
            class={className}
            aria-disabled={disabled}
        >

            <slot />

        </a>

    ) : (

        <button
            class={className}
            type={type}
            disabled={disabled}
        >

            <slot />

        </button>

    )
}