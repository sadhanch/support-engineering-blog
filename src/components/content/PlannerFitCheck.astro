---
/**
 * ==========================================================
 * Support Engineering Blog — Planner Fit Check
 * File: PlannerFitCheck.astro
 * Purpose: Provides an interactive decision aid for selecting an appropriate planning level.
 * ==========================================================
 */

import "../../assets/css/components/planner-fit-check.css";
---

<section class="planner-fit-check" aria-labelledby="planner-fit-check-title">
  <div class="planner-fit-check__header">
    <div>
      <p class="planner-fit-check__eyebrow">Decision aid</p>
      <h2 id="planner-fit-check-title">Planner Fit Check</h2>
      <p class="planner-fit-check__intro">
        Answer a few questions to identify the planning level that best matches your workload.
      </p>
    </div>

    <div class="planner-fit-check__step-count" aria-live="polite">
      <span data-step-count>Step 1 of 3</span>
    </div>
  </div>

  <div class="planner-fit-check__progress" aria-hidden="true">
    <span data-progress></span>
  </div>

  <!-- STEP 1 -->
  <div class="planner-fit-check__step" data-step="1">
    <h3>What are you primarily managing?</h3>

    <div class="planner-fit-check__options">
      <button type="button" class="planner-fit-check__option" data-value="tasks">
        <strong>Tasks and routine work</strong>
        <span>Assigning, tracking and coordinating relatively straightforward work.</span>
      </button>

      <button type="button" class="planner-fit-check__option" data-value="project">
        <strong>A structured project</strong>
        <span>Delivering an initiative with defined activities, dates and outcomes.</span>
      </button>

      <button type="button" class="planner-fit-check__option" data-value="portfolio">
        <strong>Multiple projects / enterprise PPM</strong>
        <span>Coordinating projects at a broader portfolio, resource or governance level.</span>
      </button>
    </div>
  </div>

  <!-- STEP 2 -->
  <div class="planner-fit-check__step" data-step="2" hidden>
    <h3>How does the project work behave?</h3>

    <div class="planner-fit-check__options">
      <button type="button" class="planner-fit-check__option" data-value="independent">
        <strong>Mostly independent activities</strong>
        <span>Tasks have owners and dates, but few activities depend on one another.</span>
      </button>

      <button type="button" class="planner-fit-check__option" data-value="dependent">
        <strong>Multiple dependent activities</strong>
        <span>The timing or completion of one activity affects another.</span>
      </button>

      <button type="button" class="planner-fit-check__option" data-value="complex">
        <strong>Complex schedule and delivery constraints</strong>
        <span>The project needs structured scheduling, milestones, workload visibility or critical-path analysis.</span>
      </button>
    </div>
  </div>

  <!-- STEP 3 -->
  <div class="planner-fit-check__step" data-step="3" hidden>
    <h3>What else does the organization need?</h3>

    <div class="planner-fit-check__options">
      <button type="button" class="planner-fit-check__option" data-value="portfolio-visibility">
        <strong>Portfolio visibility</strong>
        <span>A consolidated view across multiple Premium projects.</span>
      </button>

      <button type="button" class="planner-fit-check__option" data-value="resource-financial">
        <strong>Resource or financial management</strong>
        <span>Capacity, resource allocation, financial or investment concerns are central to the model.</span>
      </button>

      <button type="button" class="planner-fit-check__option" data-value="enterprise">
        <strong>Enterprise PPM and governance</strong>
        <span>Formal portfolio governance, enterprise processes, extensive integrations or specialized PPM capabilities.</span>
      </button>
    </div>
  </div>

  <!-- RESULT -->
  <div class="planner-fit-check__result" data-result hidden>
    <p class="planner-fit-check__result-label">Recommendation</p>
    <h3 data-result-title></h3>
    <p data-result-text></p>
    <p class="planner-fit-check__result-note" data-result-note></p>

    <button type="button" class="planner-fit-check__reset" data-reset>
      Start again
    </button>
  </div>

  <!-- CONTROLS -->
  <div class="planner-fit-check__controls">
    <button type="button" class="planner-fit-check__back" data-back hidden>
      ← Back
    </button>

    <button type="button" class="planner-fit-check__continue" data-continue disabled>
      Continue →
    </button>
  </div>

  <noscript>
    <p class="planner-fit-check__noscript">
      JavaScript is disabled. Please use the practical decision guide table in this article.
    </p>
  </noscript>
</section>

<script>
  const plannerFitChecks = document.querySelectorAll(".planner-fit-check");

  plannerFitChecks.forEach((root) => {
    const steps = Array.from(root.querySelectorAll("[data-step]"));
    const continueButton = root.querySelector("[data-continue]");
    const backButton = root.querySelector("[data-back]");
    const resetButton = root.querySelector("[data-reset]");
    const result = root.querySelector("[data-result]");
    const resultTitle = root.querySelector("[data-result-title]");
    const resultText = root.querySelector("[data-result-text]");
    const resultNote = root.querySelector("[data-result-note]");
    const stepCount = root.querySelector("[data-step-count]");
    const progress = root.querySelector("[data-progress]");
    const controls = root.querySelector(".planner-fit-check__controls");

    let currentStep = 1;
    let selectedValue = null;
    let firstChoice = null;

    const recommendations = {
      basic: {
        title: "Basic Planner may be sufficient",
        text: "Your workload appears to be primarily task-oriented. You may not need Premium project-management capabilities unless the nature of the work becomes more complex.",
        note: "This is a workload assessment, not a licensing determination."
      },

      premium: {
        title: "Consider Planner Premium",
        text: "Your work has characteristics of structured project delivery. Capabilities such as dependencies, Timeline, milestones, critical-path analysis and workload views may provide meaningful value.",
        note: "Validate the specific capabilities and licenses required for your users before deployment."
      },

      ecosystem: {
        title: "Evaluate the wider Microsoft ecosystem",
        text: "Your requirements extend beyond individual project execution. Evaluate Planner Premium alongside portfolio, resource, financial, integration and governance requirements.",
        note: "The right architecture depends on the organization's operating model and existing Microsoft investments."
      },

      portfolio: {
        title: "Planner Premium may be part of the solution",
        text: "Your requirement extends beyond a single project. Planner Premium and Portfolios may provide useful visibility across Premium plans, but broader portfolio, resource and governance requirements should be evaluated separately.",
        note: "Treat this as an architectural decision rather than a simple feature comparison."
      }
    };

    function showStep(number) {
      currentStep = number;
      selectedValue = null;

      steps.forEach((step) => {
        step.hidden = Number(step.dataset.step) !== number;
      });

      root.querySelectorAll(".planner-fit-check__option").forEach((option) => {
        option.classList.remove("is-selected");
      });

      continueButton.disabled = true;
      backButton.hidden = number === 1;

      stepCount.textContent = `Step ${number} of 3`;
      progress.style.width = `${(number / 3) * 100}%`;
    }

    function showResult(recommendation) {
      steps.forEach((step) => {
        step.hidden = true;
      });

      controls.hidden = true;
      result.hidden = false;

      stepCount.textContent = "Complete";
      progress.style.width = "100%";

      resultTitle.textContent = recommendation.title;
      resultText.textContent = recommendation.text;
      resultNote.textContent = recommendation.note;
    }

    function choose(value) {
      selectedValue = value;

      root
        .querySelectorAll(`[data-step="${currentStep}"] .planner-fit-check__option`)
        .forEach((option) => {
          option.classList.toggle(
            "is-selected",
            option.dataset.value === value
          );
        });

      continueButton.disabled = false;
    }

    root.querySelectorAll(".planner-fit-check__option").forEach((option) => {
      option.addEventListener("click", () => {
        choose(option.dataset.value);
      });
    });

    continueButton.addEventListener("click", () => {
      if (!selectedValue) return;

      if (currentStep === 1) {
        firstChoice = selectedValue;

        if (selectedValue === "tasks") {
          showResult(recommendations.basic);
          return;
        }

        if (selectedValue === "portfolio") {
          showStep(3);
          return;
        }

        showStep(2);
        return;
      }

      if (currentStep === 2) {
        if (selectedValue === "independent") {
          showResult(recommendations.basic);
        } else {
          showResult(recommendations.premium);
        }

        return;
      }

      if (currentStep === 3) {
        if (selectedValue === "portfolio-visibility") {
          showResult(recommendations.portfolio);
        } else {
          showResult(recommendations.ecosystem);
        }
      }
    });

    backButton.addEventListener("click", () => {
      if (currentStep === 3 && firstChoice === "portfolio") {
        showStep(1);
        return;
      }

      if (currentStep === 2) {
        showStep(1);
      }
    });

    resetButton.addEventListener("click", () => {
      firstChoice = null;
      selectedValue = null;

      result.hidden = true;
      controls.hidden = false;

      showStep(1);
    });

    showStep(1);
  });
</script>