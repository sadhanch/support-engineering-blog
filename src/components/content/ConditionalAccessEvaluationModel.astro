---
/*
 * ConditionalAccessEvaluationModel.astro
 *
 * Purpose:
 * Explains the Conditional Access evaluation sequence from sign-in
 * context through policy applicability, requirements, evaluation,
 * and final access/session outcome.
 *
 * Design:
 * - Uses the existing SEDS design tokens.
 * - No internal light/dark theme definitions.
 * - No hard-coded dark-mode values.
 * - Self-contained Astro component.
 * - Keyboard accessible.
 * - Supports reduced-motion preferences.
 */

interface Step {
  number: string;
  title: string;
  shortTitle: string;
  description: string;
  question: string;
  details: string[];
}

const steps: Step[] = [
  {
    number: "01",
    title: "Sign-In Context",
    shortTitle: "Context",
    description:
      "Microsoft Entra gathers the information needed to evaluate the access request.",
    question:
      "What do we know about this sign-in?",
    details: [
      "Identity and group membership",
      "Application or resource",
      "Device and device state",
      "Network and location",
      "Authentication and other available signals"
    ]
  },
  {
    number: "02",
    title: "Policy Applicability",
    shortTitle: "Applicability",
    description:
      "Assignments and conditions determine whether a Conditional Access policy matches the sign-in.",
    question:
      "Does this policy apply?",
    details: [
      "User or group assignment",
      "Target resource",
      "Client application",
      "Device platform",
      "Location, risk, or other configured conditions"
    ]
  },
  {
    number: "03",
    title: "Applicable Policies",
    shortTitle: "Policies",
    description:
      "Every policy whose assignments and conditions match becomes part of the access evaluation.",
    question:
      "Which policies are actually in scope?",
    details: [
      "More than one policy can apply",
      "Each applicable policy contributes its controls",
      "A successful policy does not cancel another policy",
      "The combined policy set matters"
    ]
  },
  {
    number: "04",
    title: "Requirements",
    shortTitle: "Requirements",
    description:
      "Applicable policies introduce grant, block, and session controls that shape the required outcome.",
    question:
      "What does each applicable policy require?",
    details: [
      "Grant controls such as MFA",
      "Authentication strength",
      "Device compliance or join requirements",
      "Approved client or app protection",
      "Block and session controls"
    ]
  },
  {
    number: "05",
    title: "Evaluation",
    shortTitle: "Evaluation",
    description:
      "Microsoft Entra determines whether the requirements introduced by the applicable policies are satisfied.",
    question:
      "Which requirements were satisfied?",
    details: [
      "Policy-level Success means that policy's requirements were satisfied",
      "Failure means an applicable requirement was not satisfied",
      "Not applied means the policy did not match",
      "The overall result must be interpreted across applicable policies"
    ]
  },
  {
    number: "06",
    title: "Access & Session Outcome",
    shortTitle: "Outcome",
    description:
      "The resulting access decision is followed by any applicable session controls.",
    question:
      "What experience does the user receive?",
    details: [
      "Access can be granted or blocked",
      "Session controls can limit the experience",
      "Sign-in frequency can require reauthentication",
      "Other session controls can influence the post-access experience"
    ]
  }
];
---

<section
  class="caem"
  data-caem
  aria-labelledby="caem-title"
>
  <div class="caem__header">
    <div class="caem__header-copy">
      <p class="caem__eyebrow">
        Conditional Access evaluation
      </p>

      <h3 id="caem-title">
        From Sign-In Context to Access Outcome
      </h3>

      <p class="caem__intro">
        Follow the evaluation sequence to understand how Microsoft Entra
        turns sign-in context and applicable policies into an access
        decision.
      </p>
    </div>

    <span
      class="caem__badge"
      data-progress
      aria-live="polite"
    >
      Step 01 of 06
    </span>
  </div>

  <div class="caem__body">
    <nav
      class="caem__steps"
      aria-label="Conditional Access evaluation steps"
    >
      {
        steps.map((step, index) => (
          <button
            type="button"
            class:list={[
              "caem__step",
              index === 0 && "is-active"
            ]}
            data-step={index}
            aria-current={index === 0 ? "step" : undefined}
          >
            <span
              class="caem__step-number"
              aria-hidden="true"
            >
              {step.number}
            </span>

            <span class="caem__step-body">
              <strong>{step.title}</strong>
              <small>{step.shortTitle}</small>
            </span>
          </button>
        ))
      }
    </nav>

    <div class="caem__content">
      {
        steps.map((step, index) => (
          <article
            class:list={[
              "caem__panel",
              index === 0 && "is-active"
            ]}
            data-panel={index}
            aria-hidden={index === 0 ? "false" : "true"}
          >
            <div class="caem__panel-heading">
              <span
                class="caem__panel-number"
                aria-hidden="true"
              >
                {step.number}
              </span>

              <div>
                <h4>{step.title}</h4>

                <p>
                  {step.description}
                </p>
              </div>
            </div>

            <div class="caem__question">
              <span class="caem__question-label">
                Key question
              </span>

              <strong>
                {step.question}
              </strong>
            </div>

            <div class="caem__details">
              {
                step.details.map((detail) => (
                  <div class="caem__detail">
                    <span
                      class="caem__detail-mark"
                      aria-hidden="true"
                    >
                      ✓
                    </span>

                    <span>
                      {detail}
                    </span>
                  </div>
                ))
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="caem__navigation">
    <button
      type="button"
      class="caem__nav-button"
      data-previous
      disabled
    >
      ← Previous
    </button>

    <div
      class="caem__dots"
      aria-hidden="true"
    >
      {
        steps.map((_, index) => (
          <span
            class:list={[
              "caem__dot",
              index === 0 && "is-active"
            ]}
            data-dot={index}
          ></span>
        ))
      }
    </div>

    <button
      type="button"
      class="caem__nav-button caem__nav-button--primary"
      data-next
    >
      Next →
    </button>
  </div>

  <div class="caem__principle">
    <span
      class="caem__principle-mark"
      aria-hidden="true"
    >
      →
    </span>

    <p>
      <strong>
        Don't ask which policy "won."
      </strong>

      Ask which policies applied, what they required, and which
      requirement remained unsatisfied.
    </p>
  </div>
</section>

<script>
  const root = document.querySelector("[data-caem]");

  if (root) {
    const steps = Array.from(
      root.querySelectorAll("[data-step]")
    );

    const panels = Array.from(
      root.querySelectorAll("[data-panel]")
    );

    const dots = Array.from(
      root.querySelectorAll("[data-dot]")
    );

    const progress =
      root.querySelector("[data-progress]");

    const previousButton =
      root.querySelector("[data-previous]");

    const nextButton =
      root.querySelector("[data-next]");

    let currentStep = 0;

    const update = (index) => {
      currentStep = Math.max(
        0,
        Math.min(index, steps.length - 1)
      );

      steps.forEach((step, stepIndex) => {
        const active =
          stepIndex === currentStep;

        step.classList.toggle(
          "is-active",
          active
        );

        if (active) {
          step.setAttribute(
            "aria-current",
            "step"
          );
        } else {
          step.removeAttribute(
            "aria-current"
          );
        }
      });

      panels.forEach((panel, panelIndex) => {
        const active =
          panelIndex === currentStep;

        panel.classList.toggle(
          "is-active",
          active
        );

        panel.setAttribute(
          "aria-hidden",
          String(!active)
        );
      });

      dots.forEach((dot, dotIndex) => {
        dot.classList.toggle(
          "is-active",
          dotIndex === currentStep
        );
      });

      if (progress) {
        progress.textContent =
          `Step ${String(currentStep + 1).padStart(2, "0")} of 06`;
      }

      if (
        previousButton instanceof HTMLButtonElement
      ) {
        previousButton.disabled =
          currentStep === 0;
      }

      if (
        nextButton instanceof HTMLButtonElement
      ) {
        nextButton.disabled =
          currentStep === steps.length - 1;
      }
    };

    steps.forEach((step, index) => {
      step.addEventListener(
        "click",
        () => update(index)
      );
    });

    previousButton?.addEventListener(
      "click",
      () => update(currentStep - 1)
    );

    nextButton?.addEventListener(
      "click",
      () => update(currentStep + 1)
    );

    update(0);
  }
</script>

<style>
  .caem {
    --caem-surface: var(
      --surface-primary,
      #ffffff
    );

    --caem-surface-soft: var(
      --surface-secondary,
      #f8fafc
    );

    --caem-text: var(
      --text-primary,
      #0f172a
    );

    --caem-text-secondary: var(
      --text-secondary,
      #475569
    );

    --caem-text-tertiary: var(
      --text-tertiary,
      #64748b
    );

    --caem-border: var(
      --border-default,
      #dbe3ec
    );

    --caem-border-soft: var(
      --border-subtle,
      #e7edf4
    );

    --caem-accent: var(
      --color-accent,
      #4ea1e0
    );

    --caem-state: var(
      --caem-accent
    );

    width: 100%;
    margin-block: var(
      --space-10,
      2.5rem
    );

    padding: clamp(
      1.25rem,
      3vw,
      2rem
    );

    color: var(--caem-text);
    background: var(--caem-surface);

    border: 1px solid var(--caem-border);
    border-radius: var(
      --radius-lg,
      0.875rem
    );

    box-shadow: var(
      --shadow-sm,
      0 1px 2px rgb(15 23 42 / 0.06)
    );
  }

  .caem__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-6, 1.5rem);
    margin-bottom: var(--space-6, 1.5rem);
  }

  .caem__header-copy {
    min-width: 0;
  }

  .caem__eyebrow {
    margin: 0 0 0.25rem;
    color: var(--caem-accent);
    font-size: var(
      --font-size-xs,
      0.75rem
    );
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .caem h3,
  .caem h4,
  .caem p {
    margin-top: 0;
  }

  .caem h3 {
    margin-bottom: 0.5rem;
    font-size: clamp(
      1.3rem,
      2vw,
      1.6rem
    );
    line-height: 1.2;
  }

  .caem__intro {
    max-width: 70ch;
    margin-bottom: 0;
    color: var(--caem-text-secondary);
    line-height: 1.6;
  }

  .caem__badge {
    flex: 0 0 auto;
    align-self: flex-start;

    padding: 0.45rem 0.75rem;

    color: var(--caem-state);

    background: color-mix(
      in srgb,
      var(--caem-state) 8%,
      var(--caem-surface)
    );

    border: 1px solid color-mix(
      in srgb,
      var(--caem-state) 30%,
      var(--caem-border)
    );

    border-radius: 999px;

    font-size: var(
      --font-size-xs,
      0.75rem
    );

    font-weight: 600;
    text-align: center;
  }

  .caem__body {
    display: grid;
    grid-template-columns:
      minmax(12rem, 0.8fr)
      minmax(0, 1.7fr);
    gap: var(--space-4, 1rem);
  }

  .caem__steps {
    display: grid;
    gap: var(--space-2, 0.5rem);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .caem__step {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.8rem;

    color: var(--caem-text);
    background: var(--caem-surface-soft);

    border: 1px solid var(--caem-border);
    border-radius: var(
      --radius-md,
      0.65rem
    );

    font: inherit;
    text-align: left;
    cursor: pointer;

    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .caem__step:hover {
    transform: translateY(-1px);
    border-color: var(--caem-accent);
    box-shadow: var(
      --shadow-sm,
      0 1px 2px rgb(15 23 42 / 0.06)
    );
  }

  .caem__step:focus-visible,
  .caem__nav-button:focus-visible {
    outline: 2px solid var(--caem-accent);
    outline-offset: 2px;
  }

  .caem__step.is-active {
    border-color: var(--caem-state);

    background: color-mix(
      in srgb,
      var(--caem-state) 8%,
      var(--caem-surface)
    );

    box-shadow:
      inset 0 0 0 1px var(--caem-state),
      var(
        --shadow-sm,
        0 1px 2px rgb(15 23 42 / 0.06)
      );
  }

  .caem__step-number {
    display: grid;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    place-items: center;

    color: var(--caem-text-tertiary);
    background: var(--caem-surface);

    border: 1px solid var(--caem-border);
    border-radius: 50%;

    font-size: 0.72rem;
    font-weight: 700;
  }

  .caem__step.is-active
    .caem__step-number {
    color: var(--caem-surface);
    background: var(--caem-state);
    border-color: var(--caem-state);
  }

  .caem__step-body {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .caem__step-body strong {
    line-height: 1.3;
  }

  .caem__step-body small {
    color: var(--caem-text-tertiary);
    font-size: var(
      --font-size-xs,
      0.75rem
    );
  }

  .caem__content {
    min-width: 0;
    padding: 1.25rem;

    background: var(--caem-surface-soft);

    border: 1px solid var(--caem-border);
    border-radius: var(
      --radius-md,
      0.65rem
    );
  }

  .caem__panel {
    display: none;
  }

  .caem__panel.is-active {
    display: block;
    animation: caem-fade 160ms ease;
  }

  @keyframes caem-fade {
    from {
      opacity: 0;
      transform: translateY(3px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .caem__panel-heading {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .caem__panel-number {
    display: grid;
    width: 3rem;
    height: 3rem;
    flex: 0 0 auto;
    place-items: center;

    color: var(--caem-accent);

    background: color-mix(
      in srgb,
      var(--caem-accent) 8%,
      var(--caem-surface)
    );

    border: 1px solid color-mix(
      in srgb,
      var(--caem-accent) 25%,
      var(--caem-border)
    );

    border-radius: var(
      --radius-md,
      0.65rem
    );

    font-size: 0.8rem;
    font-weight: 800;
  }

  .caem__panel h4 {
    margin-bottom: 0.4rem;
    color: var(--caem-text);

    font-size: var(
      --font-size-lg,
      1.1rem
    );

    line-height: 1.3;
  }

  .caem__panel-heading p {
    margin-bottom: 0;
    color: var(--caem-text-secondary);
    line-height: 1.6;
  }

  .caem__question {
    margin-top: 1.25rem;
    padding: 0.9rem 1rem;

    background: var(--caem-surface);

    border: 1px solid var(--caem-border-soft);
    border-left: 3px solid var(--caem-state);

    border-radius:
      0
      var(--radius-md, 0.65rem)
      var(--radius-md, 0.65rem)
      0;
  }

  .caem__question-label {
    display: block;
    margin-bottom: 0.3rem;

    color: var(--caem-text-tertiary);

    font-size: var(
      --font-size-xs,
      0.75rem
    );

    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .caem__question strong {
    color: var(--caem-text);
    line-height: 1.45;
  }

  .caem__details {
    display: grid;
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap: var(--space-3, 0.75rem);
    margin-top: 1rem;
  }

  .caem__detail {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;

    padding: 0.75rem;

    color: var(--caem-text-secondary);
    background: var(--caem-surface);

    border: 1px solid var(--caem-border-soft);
    border-radius: var(
      --radius-sm,
      0.5rem
    );

    font-size: var(
      --font-size-sm,
      0.875rem
    );

    line-height: 1.5;
  }

  .caem__detail-mark {
    display: grid;
    width: 1.2rem;
    height: 1.2rem;
    flex: 0 0 auto;
    place-items: center;

    color: var(--caem-accent);

    background: color-mix(
      in srgb,
      var(--caem-accent) 8%,
      var(--caem-surface)
    );

    border-radius: 50%;

    font-size: 0.7rem;
    font-weight: 800;
  }

  .caem__navigation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }

  .caem__nav-button {
    min-width: 6.5rem;
    padding: 0.55rem 0.8rem;

    color: var(--caem-text);
    background: var(--caem-surface);

    border: 1px solid var(--caem-border);
    border-radius: var(
      --radius-sm,
      0.5rem
    );

    font: inherit;

    font-size: var(
      --font-size-sm,
      0.875rem
    );

    font-weight: 600;
    cursor: pointer;

    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease;
  }

  .caem__nav-button:hover:not(:disabled) {
    color: var(--caem-accent);
    border-color: var(--caem-accent);
  }

  .caem__nav-button--primary {
    color: var(--caem-surface);
    background: var(--caem-accent);
    border-color: var(--caem-accent);
  }

  .caem__nav-button--primary:hover:not(:disabled) {
    color: var(--caem-surface);
    background: var(--caem-accent);
    border-color: var(--caem-accent);
  }

  .caem__nav-button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .caem__dots {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .caem__dot {
    width: 0.45rem;
    height: 0.45rem;

    background: var(--caem-border);
    border-radius: 50%;

    transition:
      background-color 160ms ease,
      transform 160ms ease;
  }

  .caem__dot.is-active {
    background: var(--caem-accent);
    transform: scale(1.25);
  }

  .caem__principle {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;

    margin-top: 1rem;
    padding: 0.9rem 1rem;

    background: var(--caem-surface-soft);

    border: 1px solid var(--caem-border-soft);
    border-radius: var(
      --radius-md,
      0.65rem
    );
  }

  .caem__principle-mark {
    flex: 0 0 auto;
    color: var(--caem-accent);
    font-weight: 800;
  }

  .caem__principle p {
    margin: 0;
    color: var(--caem-text-secondary);

    font-size: var(
      --font-size-sm,
      0.875rem
    );

    line-height: 1.55;
  }

  @media (max-width: 800px) {
    .caem__body {
      grid-template-columns: 1fr;
    }

    .caem__steps {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );
    }

    .caem__details {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .caem {
      padding: 1rem;
    }

    .caem__header {
      display: grid;
      gap: 0.9rem;
    }

    .caem__badge {
      justify-self: start;
    }

    .caem__steps {
      grid-template-columns: 1fr;
    }

    .caem__panel-heading {
      gap: 0.75rem;
    }

    .caem__navigation {
      gap: 0.5rem;
    }

    .caem__nav-button {
      min-width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caem__step,
    .caem__nav-button,
    .caem__dot {
      transition: none;
    }

    .caem__panel.is-active {
      animation: none;
    }
  }
</style>
