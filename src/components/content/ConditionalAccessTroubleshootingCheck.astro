---
/**
 * ==========================================================
 * Support Engineering Blog — Conditional Access Troubleshooting Check
 * File: ConditionalAccessTroubleshootingCheck.astro
 * Purpose: Provides a symptom-first interactive helper for Conditional Access troubleshooting.
 * ==========================================================
 */

/*
 * ConditionalAccessTroubleshootingCheck.astro
 * Symptom-first helper for Conditional Access troubleshooting.
 */
---

<section class="cactc" data-cactc aria-labelledby="cactc-title">
  <div class="cactc__header">
    <div>
      <p class="cactc__eyebrow">Troubleshooting check</p>
      <h3 id="cactc-title">What is the user actually experiencing?</h3>
      <p class="cactc__intro">
        Start with the symptom, then follow the evidence. The goal is to find
        the unmet requirement before changing Conditional Access.
      </p>
    </div>
    <span class="cactc__badge" data-badge aria-live="polite">Choose a symptom</span>
  </div>

  <fieldset class="cactc__choices">
    <legend class="cactc__legend">Select the symptom that best matches the incident</legend>

    <label class="cactc__choice">
      <input type="radio" name="cactc-symptom" value="blocked" />
      <span class="cactc__marker" aria-hidden="true"><span></span></span>
      <span class="cactc__body">
        <strong>Blocked at sign-in</strong>
        <span>The user cannot complete access to the application or resource.</span>
        <small>Sign-in status · Conditional Access · Grant controls</small>
      </span>
    </label>

    <label class="cactc__choice">
      <input type="radio" name="cactc-symptom" value="mfa" />
      <span class="cactc__marker" aria-hidden="true"><span></span></span>
      <span class="cactc__body">
        <strong>MFA succeeds, but access is denied</strong>
        <span>The user completed MFA but still cannot access the target resource.</span>
        <small>Authentication details · Authentication strength · Grant controls</small>
      </span>
    </label>

    <label class="cactc__choice">
      <input type="radio" name="cactc-symptom" value="restricted" />
      <span class="cactc__marker" aria-hidden="true"><span></span></span>
      <span class="cactc__body">
        <strong>The application opens, but an action is restricted</strong>
        <span>Sign-in succeeds, but downloading, editing, or another action is limited.</span>
        <small>Session controls · App controls · Device state</small>
      </span>
    </label>

    <label class="cactc__choice">
      <input type="radio" name="cactc-symptom" value="sensitive" />
      <span class="cactc__marker" aria-hidden="true"><span></span></span>
      <span class="cactc__body">
        <strong>Only one sensitive workflow fails</strong>
        <span>The application works until a sensitive resource or action is requested.</span>
        <small>Authentication Context · Claims challenge · Step-up</small>
      </span>
    </label>

    <label class="cactc__choice">
      <input type="radio" name="cactc-symptom" value="device" />
      <span class="cactc__marker" aria-hidden="true"><span></span></span>
      <span class="cactc__body">
        <strong>Failure occurs only on certain devices</strong>
        <span>Access depends on compliance, join state, registration, or device filtering.</span>
        <small>Device info · Compliance · Join state</small>
      </span>
    </label>

    <label class="cactc__choice">
      <input type="radio" name="cactc-symptom" value="network" />
      <span class="cactc__marker" aria-hidden="true"><span></span></span>
      <span class="cactc__body">
        <strong>Failure depends on location or network</strong>
        <span>The issue appears on a particular network, VPN, proxy path, or named location.</span>
        <small>Location · Public IP · VPN / Proxy</small>
      </span>
    </label>
  </fieldset>

  <div class="cactc__result" data-result aria-live="polite" aria-atomic="true">
    <div class="cactc__result-head">
      <span class="cactc__result-kicker">Investigation path</span>
      <span class="cactc__result-level" data-level>Waiting for selection</span>
    </div>
    <h4 data-title>Start with the exact sign-in event.</h4>
    <p data-description>
      Find the affected sign-in and identify which requirement Microsoft Entra
      evaluated as unsatisfied.
    </p>

    <div class="cactc__grid">
      <div class="cactc__card">
        <span>Check first</span>
        <strong data-focus>Sign-in logs</strong>
      </div>
      <div class="cactc__card">
        <span>Evidence</span>
        <strong data-evidence>
          Basic info, Conditional Access, authentication details, device, and location as applicable.
        </strong>
      </div>
      <div class="cactc__card">
        <span>Don't do this first</span>
        <strong data-avoid>
          Exclude the user or disable the policy without understanding the failure.
        </strong>
      </div>
    </div>
  </div>

  <div class="cactc__principle">
    <span aria-hidden="true">→</span>
    <p><strong>Symptom → Evidence → Root cause.</strong> Use the symptom to choose where to look, not which policy to weaken.</p>
  </div>
</section>

<script>
  const root = document.querySelector("[data-cactc]");

  if (root) {
    const badge = root.querySelector("[data-badge]");
    const level = root.querySelector("[data-level]");
    const title = root.querySelector("[data-title]");
    const description = root.querySelector("[data-description]");
    const focus = root.querySelector("[data-focus]");
    const evidence = root.querySelector("[data-evidence]");
    const avoid = root.querySelector("[data-avoid]");

    const results = {
      blocked: {
        badge: "Blocked at sign-in",
        level: "Start with the decision",
        title: "Find the failed sign-in and identify the unmet access requirement.",
        description: "Begin with the sign-in result, then inspect the Conditional Access evaluation before changing policy.",
        focus: "Sign-in status, Conditional Access, and applicable grant controls",
        evidence: "Status, error information, applied policies, authentication details, device state, and location as relevant.",
        avoid: "Disabling the blocking policy before confirming which requirement caused the denial."
      },
      mfa: {
        badge: "MFA succeeded",
        level: "Check the remaining requirement",
        title: "MFA success does not prove that every authentication requirement was satisfied.",
        description: "Check Authentication details and the Conditional Access evaluation for authentication strength or another grant control.",
        focus: "Authentication strength and other applicable grant controls",
        evidence: "Authentication details, applied policies, required strength, device requirements, and other grant controls.",
        avoid: "Removing MFA or assuming the problem is solved because the user completed an MFA prompt."
      },
      restricted: {
        badge: "Restricted after sign-in",
        level: "Check session behavior",
        title: "A successful sign-in can still lead to a restricted application experience.",
        description: "When access succeeds but an action is limited, investigate session controls and the application or device conditions involved.",
        focus: "Session controls and application-enforced restrictions",
        evidence: "Successful sign-in, Conditional Access session results, device information, and the restricted action.",
        avoid: "Changing authentication requirements when the restriction is being applied after access is granted."
      },
      sensitive: {
        badge: "Sensitive workflow",
        level: "Check step-up controls",
        title: "A failure limited to one sensitive action can point to Authentication Context.",
        description: "Trace the sensitive resource or action to the context request and the Conditional Access policy targeting it.",
        focus: "Authentication Context, claims challenge, and step-up requirements",
        evidence: "Authentication details, Conditional Access, context targeting, and the resulting challenge.",
        avoid: "Treating the entire application as blocked when only a protected resource or action requires additional controls."
      },
      device: {
        badge: "Device-specific failure",
        level: "Check device state",
        title: "Compare the device information with the requirement introduced by Conditional Access.",
        description: "Determine whether compliance, enrollment, registration, join state, or device filtering is responsible.",
        focus: "Device information, compliance, registration, join state, and device filters",
        evidence: "Device details, compliance state, join state, and applicable Conditional Access controls.",
        avoid: "Removing a device requirement before confirming that the device itself is the unmet condition."
      },
      network: {
        badge: "Network-specific failure",
        level: "Trace the evaluated network",
        title: "The network Microsoft Entra evaluates may not be the network the user thinks they are using.",
        description: "Trace the public IP through VPN or proxy infrastructure and compare it with the named network or location condition.",
        focus: "Location, public IP, VPN / proxy path, and named network",
        evidence: "Sign-in location, evaluated IP information, network path, and Conditional Access location conditions.",
        avoid: "Changing a named location before confirming which IP or network identity Microsoft Entra evaluated."
      }
    };

    root.querySelectorAll('input[name="cactc-symptom"]').forEach((input) => {
      input.addEventListener("change", (event) => {
        const value = event.currentTarget.value;
        const result = results[value];
        if (!result) return;

        root.dataset.state = value;
        badge.textContent = result.badge;
        level.textContent = result.level;
        title.textContent = result.title;
        description.textContent = result.description;
        focus.textContent = result.focus;
        evidence.textContent = result.evidence;
        avoid.textContent = result.avoid;
      });
    });
  }
</script>

<style>
  .cactc {
    --cactc-surface: var(--surface-primary, #fff);
    --cactc-soft: var(--surface-secondary, #f8fafc);
    --cactc-text: var(--text-primary, #0f172a);
    --cactc-secondary: var(--text-secondary, #475569);
    --cactc-tertiary: var(--text-tertiary, #64748b);
    --cactc-border: var(--border-default, #dbe3ec);
    --cactc-border-soft: var(--border-subtle, #e7edf4);
    --cactc-accent: var(--color-accent, #4ea1e0);

    width: 100%;
    margin-block: var(--space-10, 2.5rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    color: var(--cactc-text);
    background: var(--cactc-surface);
    border: 1px solid var(--cactc-border);
    border-radius: var(--radius-lg, .875rem);
    box-shadow: var(--shadow-sm, 0 1px 2px rgb(15 23 42 / .06));
  }

  .cactc__header {
    display: flex;
    justify-content: space-between;
    gap: var(--space-6, 1.5rem);
    margin-bottom: var(--space-6, 1.5rem);
  }

  .cactc__eyebrow {
    margin: 0 0 .25rem;
    color: var(--cactc-accent);
    font-size: var(--font-size-xs, .75rem);
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .cactc h3,
  .cactc h4,
  .cactc p {
    margin-top: 0;
  }

  .cactc h3 {
    margin-bottom: .5rem;
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    line-height: 1.2;
  }

  .cactc__intro {
    max-width: 70ch;
    margin-bottom: 0;
    color: var(--cactc-secondary);
    line-height: 1.6;
  }

  .cactc__badge {
    flex: 0 0 auto;
    align-self: flex-start;
    padding: .45rem .75rem;
    color: var(--cactc-secondary);
    background: var(--cactc-soft);
    border: 1px solid var(--cactc-border);
    border-radius: 999px;
    font-size: var(--font-size-xs, .75rem);
    font-weight: 600;
  }

  .cactc[data-state] {
    --cactc-state: var(--cactc-accent);
    --cactc-state-soft: color-mix(in srgb, var(--cactc-state) 8%, var(--cactc-surface));
  }

  .cactc[data-state="blocked"] { --cactc-state: #dc2626; }
  .cactc[data-state="mfa"] { --cactc-state: #6d3bb8; }
  .cactc[data-state="restricted"] { --cactc-state: #c2410c; }
  .cactc[data-state="sensitive"] { --cactc-state: #2563eb; }
  .cactc[data-state="device"] { --cactc-state: #15803d; }
  .cactc[data-state="network"] { --cactc-state: #0f766e; }

  .cactc[data-state] .cactc__badge {
    color: var(--cactc-state);
    background: color-mix(in srgb, var(--cactc-state) 8%, var(--cactc-surface));
    border-color: color-mix(in srgb, var(--cactc-state) 30%, var(--cactc-border));
  }

  .cactc__choices {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3, .75rem);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .cactc__legend {
    width: 100%;
    margin-bottom: .75rem;
    font-size: var(--font-size-sm, .875rem);
    font-weight: 600;
  }

  .cactc__choice {
    position: relative;
    display: block;
    height: 100%;
    padding: .95rem;
    background: var(--cactc-soft);
    border: 1px solid var(--cactc-border);
    border-radius: var(--radius-md, .65rem);
    cursor: pointer;
    transition: border-color 160ms ease, background-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .cactc__choice:hover {
    transform: translateY(-1px);
    border-color: var(--cactc-accent);
    box-shadow: var(--shadow-sm, 0 1px 2px rgb(15 23 42 / .06));
  }

  .cactc__choice:has(input:focus-visible) {
    outline: 2px solid var(--cactc-accent);
    outline-offset: 2px;
  }

  .cactc__choice input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .cactc__choice:has(input:checked) {
    border-color: var(--cactc-state, var(--cactc-accent));
    background: color-mix(in srgb, var(--cactc-state, var(--cactc-accent)) 8%, var(--cactc-surface));
    box-shadow: inset 0 0 0 1px var(--cactc-state, var(--cactc-accent)), var(--shadow-sm, 0 1px 2px rgb(15 23 42 / .06));
  }

  .cactc__marker {
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    margin-bottom: .7rem;
    border: 2px solid var(--cactc-tertiary);
    border-radius: 50%;
  }

  .cactc__marker span {
    width: .48rem;
    height: .48rem;
    border-radius: 50%;
  }

  .cactc__choice:has(input:checked) .cactc__marker {
    border-color: var(--cactc-state, var(--cactc-accent));
  }

  .cactc__choice:has(input:checked) .cactc__marker span {
    background: var(--cactc-state, var(--cactc-accent));
  }

  .cactc__body {
    display: grid;
    gap: .35rem;
  }

  .cactc__body strong {
    line-height: 1.3;
  }

  .cactc__body > span {
    color: var(--cactc-secondary);
    font-size: var(--font-size-sm, .875rem);
    line-height: 1.5;
  }

  .cactc__body small {
    color: var(--cactc-tertiary);
    font-size: var(--font-size-xs, .75rem);
    line-height: 1.45;
  }

  .cactc__result {
    margin-top: var(--space-6, 1.5rem);
    padding: 1.2rem;
    background: var(--cactc-soft);
    border: 1px solid var(--cactc-border);
    border-left: 4px solid var(--cactc-state, var(--cactc-accent));
    border-radius: var(--radius-md, .65rem);
  }

  .cactc__result-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: .4rem;
  }

  .cactc__result-kicker,
  .cactc__card > span {
    color: var(--cactc-tertiary);
    font-size: var(--font-size-xs, .75rem);
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .cactc__result-level {
    color: var(--cactc-state, var(--cactc-accent));
    font-size: var(--font-size-sm, .875rem);
    font-weight: 600;
  }

  .cactc__result h4 {
    margin-bottom: .45rem;
    font-size: var(--font-size-lg, 1.1rem);
  }

  .cactc__result > p {
    max-width: 72ch;
    margin-bottom: 0;
    color: var(--cactc-secondary);
    line-height: 1.6;
  }

  .cactc__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3, .75rem);
    margin-top: 1rem;
  }

  .cactc__card {
    display: grid;
    gap: .35rem;
    padding: .85rem .9rem;
    background: var(--cactc-surface);
    border: 1px solid var(--cactc-border-soft);
    border-radius: var(--radius-sm, .5rem);
  }

  .cactc__card strong {
    color: var(--cactc-secondary);
    font-size: var(--font-size-sm, .875rem);
    line-height: 1.5;
  }

  .cactc__card strong:first-letter {
    color: var(--cactc-text);
  }

  .cactc__principle {
    display: flex;
    gap: .8rem;
    margin-top: 1rem;
    padding: .9rem 1rem;
    background: var(--cactc-surface);
    border: 1px solid var(--cactc-border-soft);
    border-radius: var(--radius-md, .65rem);
  }

  .cactc__principle > span {
    flex: 0 0 auto;
    color: var(--cactc-accent);
    font-weight: 700;
  }

  .cactc__principle p {
    margin: 0;
    color: var(--cactc-secondary);
    font-size: var(--font-size-sm, .875rem);
    line-height: 1.55;
  }

  @media (max-width: 1050px) {
    .cactc__choices { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 900px) {
    .cactc__grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .cactc { padding: 1rem; }
    .cactc__header { display: grid; gap: .9rem; }
    .cactc__badge { justify-self: start; }
    .cactc__choices { grid-template-columns: 1fr; }
    .cactc__result-head { align-items: flex-start; flex-direction: column; gap: .35rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cactc__choice { transition: none; }
  }
</style>
