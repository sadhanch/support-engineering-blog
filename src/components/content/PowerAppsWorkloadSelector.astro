---
/*
 * PowerAppsWorkloadSelector.astro
 *
 * Purpose:
 * Helps readers choose the Power Apps application model that best fits
 * a workload.
 *
 * The selector follows the article's beginner mental model:
 * experience-first → Canvas Apps
 * data-first → Model-Driven Apps
 * external experience → Power Pages
 * advanced extension → Code / AI-assisted experiences
 *
 * Self-contained Astro component.
 */
---

<section
  class="paws"
  data-paws
  aria-labelledby="paws-title"
>
  <div class="paws__header">
    <div class="paws__header-copy">
      <p class="paws__eyebrow">Workload selector</p>

      <h3 id="paws-title">
        Which Power Apps model fits your scenario?
      </h3>

      <p class="paws__intro">
        Choose the shape of the solution you are building. The selector points
        you toward the Power Apps experience that best matches the workload
        and explains what to consider next.
      </p>
    </div>

    <span class="paws__badge" data-badge aria-live="polite">
      Choose a scenario
    </span>
  </div>

  <fieldset class="paws__choices">
    <legend class="paws__legend">
      Select the scenario that best describes your workload
    </legend>

    <label class="paws__choice">
      <input
        type="radio"
        name="power-apps-workload"
        value="canvas"
      />
      <span class="paws__marker" aria-hidden="true">
        <span></span>
      </span>

      <span class="paws__choice-body">
        <strong>Custom user experience</strong>

        <span>
          The experience needs flexible screens, tailored layouts, mobile
          behavior, or task-focused data capture.
        </span>

        <small>EXPERIENCE FIRST · CANVAS APPS</small>
      </span>
    </label>

    <label class="paws__choice">
      <input
        type="radio"
        name="power-apps-workload"
        value="model-driven"
      />
      <span class="paws__marker" aria-hidden="true">
        <span></span>
      </span>

      <span class="paws__choice-body">
        <strong>Data-driven business process</strong>

        <span>
          The solution centers on structured business data, relationships,
          forms, views, dashboards, and repeatable processes.
        </span>

        <small>DATA FIRST · MODEL-DRIVEN APPS</small>
      </span>
    </label>

    <label class="paws__choice">
      <input
        type="radio"
        name="power-apps-workload"
        value="power-pages"
      />
      <span class="paws__marker" aria-hidden="true">
        <span></span>
      </span>

      <span class="paws__choice-body">
        <strong>External-facing experience</strong>

        <span>
          Customers, partners, suppliers, citizens, or other external users
          need a secure website or portal experience.
        </span>

        <small>EXTERNAL EXPERIENCE · POWER PAGES</small>
      </span>
    </label>

    <label class="paws__choice">
      <input
        type="radio"
        name="power-apps-workload"
        value="advanced"
      />
      <span class="paws__marker" aria-hidden="true">
        <span></span>
      </span>

      <span class="paws__choice-body">
        <strong>Advanced customization or extension</strong>

        <span>
          The workload needs code, APIs, reusable components, professional
          developer extension, or AI-assisted application experiences.
        </span>

        <small>EXTEND · CODE / AI-ASSISTED</small>
      </span>
    </label>
  </fieldset>

  <div
    class="paws__result"
    aria-live="polite"
    aria-atomic="true"
  >
    <div class="paws__result-head">
      <div>
        <span class="paws__result-kicker">Recommended direction</span>

        <h4 data-title>
          Select a scenario above.
        </h4>
      </div>

      <span class="paws__result-level" data-level>
        Waiting for selection
      </span>
    </div>

    <p class="paws__result-description" data-description>
      The right Power Apps model depends on how the workload is structured.
    </p>

    <div class="paws__grid">
      <div class="paws__card">
        <span class="paws__card-label">Start with</span>

        <strong data-start>
          Choose a workload
        </strong>
      </div>

      <div class="paws__card">
        <span class="paws__card-label">Best fit</span>

        <strong data-fit>
          Select a scenario to see the recommended model.
        </strong>
      </div>

      <div class="paws__card">
        <span class="paws__card-label">What to consider next</span>

        <strong data-next>
          Your architecture should follow the workload.
        </strong>
      </div>
    </div>
  </div>

  <div class="paws__principle">
    <span class="paws__principle-mark" aria-hidden="true">→</span>

    <p>
      <strong>Choose the workload first.</strong>
      Do not select a Power Apps model simply because it is familiar. Start
      with the experience, data, audience, and extension requirements.
    </p>
  </div>
</section>

<script>
  const root = document.querySelector("[data-paws]");

  if (root) {
    const badge = root.querySelector("[data-badge]");
    const title = root.querySelector("[data-title]");
    const level = root.querySelector("[data-level]");
    const description = root.querySelector("[data-description]");
    const start = root.querySelector("[data-start]");
    const fit = root.querySelector("[data-fit]");
    const next = root.querySelector("[data-next]");

    const results = {
      canvas: {
        badge: "EXPERIENCE FIRST · CANVAS",
        level: "Start with the user experience",
        title: "Canvas Apps are the natural starting point.",
        description:
          "Use Canvas Apps when the application needs a tailored interface, flexible layout, mobile behavior, or task-focused interaction.",
        start:
          "The user journey, screens, controls, and interaction model.",
        fit:
          "Canvas App with the data sources and connectors required by the workload.",
        next:
          "Check responsiveness, accessibility, delegation, data-source fit, and connector behavior before scaling."
      },

      "model-driven": {
        badge: "DATA FIRST · MODEL-DRIVEN",
        level: "Start with the business data",
        title: "A Model-Driven App fits structured, data-heavy processes.",
        description:
          "Use Model-Driven Apps when the application revolves around Dataverse data, relationships, forms, views, dashboards, and repeatable business processes.",
        start:
          "The Dataverse data model, relationships, business process, and security requirements.",
        fit:
          "Model-Driven App backed by Dataverse.",
        next:
          "Design tables, relationships, security roles, views, forms, and the lifecycle around the application."
      },

      "power-pages": {
        badge: "EXTERNAL EXPERIENCE · POWER PAGES",
        level: "Start with the audience",
        title: "Power Pages fits external-facing website and portal scenarios.",
        description:
          "Use Power Pages when customers, partners, suppliers, citizens, or other external users need a secure web experience connected to business data.",
        start:
          "The external audience, authentication model, web experience, and data they need.",
        fit:
          "Power Pages with the required Dataverse and web security model.",
        next:
          "Plan authentication, web roles, table permissions, page access, external-user licensing, and operational security."
      },

      advanced: {
        badge: "EXTEND · CODE / AI-ASSISTED",
        level: "Extend the platform",
        title: "Advanced requirements may need pro-code or AI-assisted experiences.",
        description:
          "Use code-based extensions, APIs, reusable components, or newer AI-assisted experiences when the workload exceeds what the standard low-code model can comfortably provide.",
        start:
          "The capability gap: custom integration, reusable components, complex behavior, or AI-assisted development.",
        fit:
          "Power Apps extended with code, APIs, professional developer tooling, or supported AI-assisted capabilities.",
        next:
          "Define ownership, integration boundaries, security, deployment, and the long-term support model."
      }
    };

    root
      .querySelectorAll('input[name="power-apps-workload"]')
      .forEach((input) => {
        input.addEventListener("change", (event) => {
          const value = event.currentTarget.value;
          const result = results[value];

          if (!result) return;

          root.dataset.state = value;

          badge.textContent = result.badge;
          level.textContent = result.level;
          title.textContent = result.title;
          description.textContent = result.description;
          start.textContent = result.start;
          fit.textContent = result.fit;
          next.textContent = result.next;
        });
      });
  }
</script>

<style>
  .paws {
    --paws-surface: var(--surface-primary, #ffffff);
    --paws-surface-soft: var(--surface-secondary, #f8fafc);
    --paws-text: var(--text-primary, #0f172a);
    --paws-text-secondary: var(--text-secondary, #475569);
    --paws-text-tertiary: var(--text-tertiary, #64748b);
    --paws-border: var(--border-default, #dbe3ec);
    --paws-border-soft: var(--border-subtle, #e7edf4);
    --paws-accent: var(--color-accent, #4ea1e0);
    --paws-state: var(--paws-accent);

    width: 100%;
    margin-block: var(--space-10, 2.5rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    color: var(--paws-text);
    background: var(--paws-surface);
    border: 1px solid var(--paws-border);
    border-radius: var(--radius-lg, 0.875rem);
    box-shadow: var(--shadow-sm, 0 1px 2px rgb(15 23 42 / 0.06));
  }

  .paws[data-state="canvas"] {
    --paws-state: var(--color-accent, #4ea1e0);
  }

  .paws[data-state="model-driven"] {
    --paws-state: var(--color-success, #15803d);
  }

  .paws[data-state="power-pages"] {
    --paws-state: var(--color-info, #0f8a8a);
  }

  .paws[data-state="advanced"] {
    --paws-state: var(--color-warning, #c2410c);
  }

  .paws__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-6, 1.5rem);
    margin-bottom: var(--space-6, 1.5rem);
  }

  .paws__eyebrow {
    margin: 0 0 0.25rem;
    color: var(--paws-state);
    font-size: var(--font-size-xs, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .paws h3,
  .paws h4,
  .paws p {
    margin-top: 0;
  }

  .paws h3 {
    margin-bottom: 0.5rem;
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    line-height: 1.2;
  }

  .paws__intro {
    max-width: 70ch;
    margin-bottom: 0;
    color: var(--paws-text-secondary);
    line-height: 1.6;
  }

  .paws__badge {
    flex: 0 0 auto;
    align-self: flex-start;
    padding: 0.45rem 0.75rem;
    color: var(--paws-state);
    background: color-mix(
      in srgb,
      var(--paws-state) 8%,
      var(--paws-surface)
    );
    border: 1px solid color-mix(
      in srgb,
      var(--paws-state) 30%,
      var(--paws-border)
    );
    border-radius: 999px;
    font-size: var(--font-size-xs, 0.75rem);
    font-weight: 600;
    text-align: center;
  }

  .paws__choices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3, 0.75rem);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .paws__legend {
    width: 100%;
    margin-bottom: 0.75rem;
    color: var(--paws-text);
    font-size: var(--font-size-sm, 0.875rem);
    font-weight: 600;
  }

  .paws__choice {
    position: relative;
    display: block;
    height: 100%;
    padding: 0.95rem;
    background: var(--paws-surface-soft);
    border: 1px solid var(--paws-border);
    border-radius: var(--radius-md, 0.65rem);
    cursor: pointer;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .paws__choice:hover {
    transform: translateY(-1px);
    border-color: var(--paws-accent);
    box-shadow: var(--shadow-sm, 0 1px 2px rgb(15 23 42 / 0.06));
  }

  .paws__choice:has(input:focus-visible) {
    outline: 2px solid var(--paws-accent);
    outline-offset: 2px;
  }

  .paws__choice input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .paws__choice:has(input:checked) {
    border-color: var(--paws-state);
    background: color-mix(
      in srgb,
      var(--paws-state) 8%,
      var(--paws-surface)
    );
    box-shadow:
      inset 0 0 0 1px var(--paws-state),
      var(--shadow-sm, 0 1px 2px rgb(15 23 42 / 0.06));
  }

  .paws__marker {
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    margin-bottom: 0.7rem;
    border: 2px solid var(--paws-text-tertiary);
    border-radius: 50%;
  }

  .paws__marker span {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
  }

  .paws__choice:has(input:checked) .paws__marker {
    border-color: var(--paws-state);
  }

  .paws__choice:has(input:checked) .paws__marker span {
    background: var(--paws-state);
  }

  .paws__choice-body {
    display: grid;
    gap: 0.35rem;
  }

  .paws__choice-body strong {
    color: var(--paws-text);
    line-height: 1.3;
  }

  .paws__choice-body > span {
    color: var(--paws-text-secondary);
    font-size: var(--font-size-sm, 0.875rem);
    line-height: 1.5;
  }

  .paws__choice-body small {
    color: var(--paws-text-tertiary);
    font-size: var(--font-size-xs, 0.75rem);
    font-weight: 600;
    line-height: 1.4;
  }

  .paws__result {
    margin-top: var(--space-6, 1.5rem);
    padding: 1.2rem;
    background: var(--paws-surface-soft);
    border: 1px solid var(--paws-border);
    border-left: 4px solid var(--paws-state);
    border-radius: var(--radius-md, 0.65rem);
  }

  .paws__result-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .paws__result-kicker {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--paws-text-tertiary);
    font-size: var(--font-size-xs, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .paws__result h4 {
    margin-bottom: 0;
    color: var(--paws-text);
    font-size: var(--font-size-lg, 1.1rem);
    line-height: 1.3;
  }

  .paws__result-level {
    flex: 0 0 auto;
    color: var(--paws-state);
    font-size: var(--font-size-sm, 0.875rem);
    font-weight: 600;
  }

  .paws__result-description {
    max-width: 72ch;
    margin: 0.65rem 0 0;
    color: var(--paws-text-secondary);
    line-height: 1.6;
  }

  .paws__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3, 0.75rem);
    margin-top: 1rem;
  }

  .paws__card {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem;
    background: var(--paws-surface);
    border: 1px solid var(--paws-border-soft);
    border-radius: var(--radius-sm, 0.5rem);
  }

  .paws__card-label {
    color: var(--paws-text-tertiary);
    font-size: var(--font-size-xs, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .paws__card strong {
    color: var(--paws-text-secondary);
    font-size: var(--font-size-sm, 0.875rem);
    line-height: 1.55;
  }

  .paws__principle {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    background: var(--paws-surface);
    border: 1px solid var(--paws-border-soft);
    border-radius: var(--radius-md, 0.65rem);
  }

  .paws__principle-mark {
    flex: 0 0 auto;
    color: var(--paws-accent);
    font-weight: 800;
  }

  .paws__principle p {
    margin: 0;
    color: var(--paws-text-secondary);
    font-size: var(--font-size-sm, 0.875rem);
    line-height: 1.55;
  }

  @media (max-width: 800px) {
    .paws__choices {
      grid-template-columns: 1fr;
    }

    .paws__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .paws {
      padding: 1rem;
    }

    .paws__header {
      display: grid;
      gap: 0.9rem;
    }

    .paws__badge {
      justify-self: start;
    }

    .paws__result-head {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .paws__choice {
      transition: none;
    }
  }
</style>
