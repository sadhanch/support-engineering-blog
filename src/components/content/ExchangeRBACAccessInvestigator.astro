---
const cases = [
  { id: 'cmdlet', n: '01', title: 'Cmdlet unavailable', cause: 'The role entry may be missing, the session may be stale, or the administrative context may be wrong.', evidence: ['Identify the actor and effective role-group membership.', 'Inspect the management role entry and exposed parameters.', 'Confirm the current Exchange administrative context.'], commands: ["Get-RoleGroupMember -Identity '<role-group>'", "Get-ManagementRoleAssignment -RoleAssignee '<user-or-group>' -GetEffectiveUsers", "Get-ManagementRoleEntry '<role>\\<cmdlet>' | Format-List Name,Parameters"] },
  { id: 'parameter', n: '02', title: 'Parameter denied', cause: 'The cmdlet may exist while the requested parameter is not exposed through the effective role entry.', evidence: ['Confirm the exact cmdlet and parameter.', 'Inspect the effective role entry.', 'Check whether a custom role intentionally removed the parameter.'], commands: ["Get-ManagementRoleEntry '<role>\\<cmdlet>' | Format-List Name,Parameters"] },
  { id: 'readwrite', n: '03', title: 'Can view but not modify', cause: 'The target is visible through the effective read path, but the write boundary does not include it.', evidence: ['Inspect the assignment read/write scopes.', 'Compare the target against the scope definition.', 'Test in-scope and out-of-scope targets.'], commands: ["Get-ManagementRoleAssignment -Identity '<assignment>' | Format-List *Scope*", "Get-ManagementScope -Identity '<scope>' | Format-List *"] },
  { id: 'outside', n: '04', title: 'Can modify outside intended scope', cause: 'Another role group, direct assignment, broader scope, or other control plane may provide an additional authorization path.', evidence: ['Enumerate every effective assignment.', 'Check direct assignments as well as group membership.', 'For applications, inspect Exchange assignments and Entra grants together.'], commands: ["Get-ManagementRoleAssignment -RoleAssignee '<user-or-group>' -GetEffectiveUsers", "Get-ManagementRoleAssignment -RoleAssignee $ServicePrincipalObjectId | Format-List *"] },
  { id: 'forbidden', n: '05', title: 'Application receives Forbidden', cause: 'Authentication succeeded, but the Exchange application role, scope, or effective authorization path does not permit the operation.', evidence: ['Confirm the Exchange-side service-principal representation.', 'Inspect Application RBAC assignments and resource scope.', 'Test an included and excluded resource.'], commands: ["Get-ServicePrincipal -Identity $ServicePrincipalObjectId | Format-List *", "Test-ServicePrincipalAuthorization -Identity $ServicePrincipalObjectId -Resource '<target-mailbox>'"] },
  { id: 'broadapp', n: '06', title: 'Application reaches every mailbox', cause: 'A broad Microsoft Entra application permission or another unscoped authorization path may be bypassing the intended Exchange boundary.', evidence: ['Inventory every Exchange Application RBAC assignment.', 'Review Microsoft Entra API permissions.', 'Test an out-of-scope mailbox before and after remediation.'], commands: ["Get-ManagementRoleAssignment -RoleAssignee $ServicePrincipalObjectId | Format-List *", "Get-ServicePrincipal -Identity $ServicePrincipalObjectId | Format-List *"] },
  { id: 'scope', n: '07', title: 'Expected mailbox is outside scope', cause: 'The mailbox may not match the recipient filter or administrative-unit boundary, or its recipient type/attributes may differ from the design.', evidence: ['Inspect the target recipient attributes.', 'Review the scope or administrative-unit definition.', 'Compare with a known matching mailbox.'], commands: ["Get-ManagementScope -Identity '<scope>' | Format-List *", "Get-ManagementRoleAssignment -Identity '<assignment>' | Format-List *Scope*"] }
];
const defaultId = cases[0].id;
---
<section class="exchange-rbac-access-investigator" aria-labelledby="exchange-rbac-access-investigator-title">
  <header class="exchange-rbac-access-investigator__header">
    <p class="exchange-rbac-access-investigator__eyebrow">Effective-access investigator</p>
    <h2 id="exchange-rbac-access-investigator-title">Start with the actor. Then follow every path.</h2>
    <p class="exchange-rbac-access-investigator__intro">Choose the symptom that matches the incident and work from actor and operation through assignment, scope, other authorization paths, and proof.</p>
  </header>
  <div class="exchange-rbac-access-investigator__layout">
    <nav class="exchange-rbac-access-investigator__choices" aria-label="Exchange RBAC troubleshooting symptoms" role="tablist">
      {cases.map((item) => (
        <button type="button" class:list={["exchange-rbac-access-investigator__choice", { "is-active": item.id === defaultId }]} data-choice={item.id} aria-controls={`exchange-rbac-access-investigator-${item.id}`} aria-selected={item.id === defaultId} role="tab" tabindex={item.id === defaultId ? 0 : -1}>
          <span class="exchange-rbac-access-investigator__number">{item.n}</span><span><strong>{item.title}</strong><small>Follow the evidence</small></span>
        </button>
      ))}
    </nav>
    <div class="exchange-rbac-access-investigator__content">
      {cases.map((item) => (
        <article id={`exchange-rbac-access-investigator-${item.id}`} class:list={["exchange-rbac-access-investigator__panel", { "is-active": item.id === defaultId }]} data-panel={item.id} role="tabpanel" hidden={item.id !== defaultId}>
          <span class="exchange-rbac-access-investigator__kicker">{item.n} · {item.title}</span>
          <h3>What may be happening?</h3><p>{item.cause}</p>
          <div class="exchange-rbac-access-investigator__flow"><span>Actor</span><b>→</b><span>Operation</span><b>→</b><span>Assignment</span><b>→</b><span>Scope</span><b>→</b><span>Other paths</span></div>
          <div class="exchange-rbac-access-investigator__evidence">
            <section class="exchange-rbac-access-investigator__card"><span class="exchange-rbac-access-investigator__card-label">Investigate</span><h4>Evidence to collect</h4><ul>{item.evidence.map((x) => <li>{x}</li>)}</ul></section>
            <section class="exchange-rbac-access-investigator__card"><span class="exchange-rbac-access-investigator__card-label">Inspect</span><h4>Useful PowerShell</h4><div class="exchange-rbac-access-investigator__commands">{item.commands.map((x) => <code>{x}</code>)}</div></section>
          </div>
          <div class="exchange-rbac-access-investigator__validation"><strong>Finish with proof:</strong> test one known allowed case and one known denied case whenever the scenario permits it.</div>
        </article>
      ))}
    </div>
  </div>
  <footer class="exchange-rbac-access-investigator__footer"><strong>Investigation rule:</strong> do not stop when you find the permission you expected. Continue until you know whether another assignment or control plane can also grant the same access.</footer>
</section>
<script>
  const init = () => document.querySelectorAll('.exchange-rbac-access-investigator').forEach((root) => {
    const tabs = [...root.querySelectorAll('[data-choice]')]; const panels = [...root.querySelectorAll('[data-panel]')]; if (!tabs.length) return;
    const activate = (id, focus=false) => { tabs.forEach(t=>{const a=t.dataset.choice===id;t.classList.toggle('is-active',a);t.setAttribute('aria-selected',String(a));t.tabIndex=a?0:-1}); panels.forEach(p=>{const a=p.dataset.panel===id;p.hidden=!a;p.classList.toggle('is-active',a)}); if(focus) tabs.find(t=>t.dataset.choice===id)?.focus(); };
    tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>activate(tab.dataset.choice||''));tab.addEventListener('keydown',e=>{if(!['ArrowDown','ArrowUp','Home','End'].includes(e.key))return;e.preventDefault();let n=i;if(e.key==='ArrowDown')n=(i+1)%tabs.length;if(e.key==='ArrowUp')n=(i-1+tabs.length)%tabs.length;if(e.key==='Home')n=0;if(e.key==='End')n=tabs.length-1;activate(tabs[n].dataset.choice||'',true)})});
  });
  init(); document.addEventListener('astro:page-load', init);
</script>
<style>
.exchange-rbac-access-investigator{--i-b:var(--border-default);--i-bs:var(--border-subtle);--i-t:var(--text-primary);--i-m:var(--text-secondary);--i-a:var(--color-accent);--i-s:var(--surface-primary);--i-ss:var(--surface-secondary);width:100%;margin:var(--space-10) 0;border:1px solid var(--i-b);border-radius:var(--radius-lg);background:var(--i-s);color:var(--i-t);overflow:hidden;box-shadow:var(--shadow-sm)}
.exchange-rbac-access-investigator__header{padding:var(--space-6);border-bottom:1px solid var(--i-b)}.exchange-rbac-access-investigator__eyebrow,.exchange-rbac-access-investigator__kicker,.exchange-rbac-access-investigator__card-label{margin:0 0 var(--space-1);color:var(--i-a);font-size:var(--font-size-xs);font-weight:var(--font-weight-bold);letter-spacing:.08em;text-transform:uppercase}.exchange-rbac-access-investigator h2{margin:0;font-size:clamp(1.45rem,2.6vw,1.95rem);line-height:var(--line-height-tight)}.exchange-rbac-access-investigator__intro{max-width:780px;margin:var(--space-3) 0 0;color:var(--i-m);line-height:var(--line-height-relaxed)}
.exchange-rbac-access-investigator__layout{display:grid;grid-template-columns:minmax(15rem,.72fr) minmax(0,1.8fr)}.exchange-rbac-access-investigator__choices{display:flex;flex-direction:column;border-right:1px solid var(--i-b);background:var(--i-ss)}.exchange-rbac-access-investigator__choice{display:grid;grid-template-columns:2.2rem 1fr;gap:var(--space-3);width:100%;padding:var(--space-4);border:0;border-bottom:1px solid var(--i-bs);background:transparent;color:inherit;font:inherit;text-align:left;cursor:pointer}.exchange-rbac-access-investigator__choice:hover,.exchange-rbac-access-investigator__choice.is-active{background:color-mix(in srgb,var(--i-a) 9%,var(--i-ss))}.exchange-rbac-access-investigator__choice.is-active{box-shadow:inset 3px 0 0 var(--i-a)}.exchange-rbac-access-investigator__choice:focus-visible{outline:3px solid color-mix(in srgb,var(--i-a) 35%,transparent);outline-offset:-3px}.exchange-rbac-access-investigator__number{color:var(--i-a);font-size:var(--font-size-sm);font-weight:var(--font-weight-bold)}.exchange-rbac-access-investigator__choice strong{display:block;font-weight:var(--font-weight-semibold)}.exchange-rbac-access-investigator__choice small{display:block;margin-top:var(--space-2);color:var(--i-m);font-size:var(--font-size-sm)}
.exchange-rbac-access-investigator__panel{padding:var(--space-6)}.exchange-rbac-access-investigator__panel h3{margin:0;font-size:var(--font-heading-md);line-height:var(--line-height-tight)}.exchange-rbac-access-investigator__panel>p{margin:var(--space-2) 0 0;color:var(--i-m);line-height:var(--line-height-relaxed)}.exchange-rbac-access-investigator__flow{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-2);margin-top:var(--space-5);padding:var(--space-4);border:1px solid var(--i-b);border-radius:var(--radius-md);background:var(--i-ss)}.exchange-rbac-access-investigator__flow span{padding:var(--space-2) var(--space-3);border:1px solid var(--i-b);border-radius:var(--radius-pill);font-size:var(--font-size-sm);font-weight:var(--font-weight-semibold)}.exchange-rbac-access-investigator__flow b{color:var(--i-m)}
.exchange-rbac-access-investigator__evidence{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4);margin-top:var(--space-5)}.exchange-rbac-access-investigator__card{min-width:0;padding:var(--space-5);border:1px solid var(--i-bs);border-radius:var(--radius-md);background:var(--i-ss)}.exchange-rbac-access-investigator__card h4{margin:0;font-size:var(--font-body-lg);line-height:var(--line-height-tight)}.exchange-rbac-access-investigator__card ul{margin:var(--space-3) 0 0;padding-left:1.2rem}.exchange-rbac-access-investigator__card li{margin:var(--space-2) 0;color:var(--i-m);line-height:var(--line-height-normal)}.exchange-rbac-access-investigator__commands{display:grid;gap:var(--space-2);margin-top:var(--space-3)}.exchange-rbac-access-investigator__commands code{display:block;padding:var(--space-3);border:1px solid var(--i-bs);border-radius:var(--radius-sm);background:var(--i-s);font-size:var(--font-size-xs);line-height:1.55;overflow-wrap:anywhere}.exchange-rbac-access-investigator__validation{margin-top:var(--space-5);padding:var(--space-4);border:1px solid var(--i-b);border-radius:var(--radius-md);background:var(--i-ss);color:var(--i-m);line-height:var(--line-height-relaxed)}.exchange-rbac-access-investigator__validation strong,.exchange-rbac-access-investigator__footer strong{color:var(--i-t)}.exchange-rbac-access-investigator__footer{padding:var(--space-4) var(--space-6);border-top:1px solid var(--i-b);color:var(--i-m);font-size:var(--font-size-sm);line-height:var(--line-height-relaxed)}
@media(max-width:900px){.exchange-rbac-access-investigator__layout{grid-template-columns:1fr}.exchange-rbac-access-investigator__choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-right:0;border-bottom:1px solid var(--i-b)}}@media(max-width:650px){.exchange-rbac-access-investigator__choices,.exchange-rbac-access-investigator__evidence{grid-template-columns:1fr}.exchange-rbac-access-investigator__header,.exchange-rbac-access-investigator__panel,.exchange-rbac-access-investigator__footer{padding-left:var(--space-4);padding-right:var(--space-4)}.exchange-rbac-access-investigator__flow{flex-direction:column;align-items:flex-start}}
</style>
