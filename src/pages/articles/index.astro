---
/**
 * ==========================================================
 * SEDS — Articles Archive
 * Purpose: Displays all published articles in reverse
 * chronological order.
 * ==========================================================
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/layout/Container.astro";
import Section from "../../components/layout/Section.astro";

import ArticleListItem from "../../components/article/ArticleListItem.astro";

import { getAllArticles } from "../../lib/articles";

const articles = await getAllArticles();
---

<BaseLayout

    title="Articles | Support Engineering Blog"

    description="Browse published articles covering Microsoft 365 administration, support engineering, automation, and related technologies."

>

    <main

        id="main-content"

        class="articles-page"

    >

        <Section>

            <Container>

                <!-- ==================================================
                     Archive Header
                     ================================================== -->

                <header class="articles-header">

                    <h1>

                        Articles

                    </h1>

                    <p>

                        Browse published articles covering Microsoft 365
                        administration, support engineering, automation,
                        and related technologies.

                    </p>

                </header>


                <!-- ==================================================
                     Article Archive
                     ================================================== -->

                <section
                    class="articles-list"
                    aria-label="Published articles"
                >

                    {

                        articles.map((article) => (

                            <ArticleListItem

                                href={`/articles/${article.id}`}

                                title={article.data.title}

                                category={article.data.category}

                                excerpt={article.data.excerpt}

                                readingTime={article.readingTime}

                            />

                        ))

                    }

                </section>

            </Container>

        </Section>

    </main>

</BaseLayout>