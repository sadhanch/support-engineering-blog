---
/* ==========================================================
   SEDS — Article Page
   ----------------------------------------------------------
   Purpose:
   Generates individual article pages from the content
   collection and passes article data into ArticleLayout.
   ========================================================== */

import { render } from "astro:content";

import ArticleLayout from "../../layouts/ArticleLayout.astro";

import {
    getArticleBySlug,
    getAllArticles
} from "../../lib/articles";

import { getRelatedArticles } from "../../lib/relatedArticles";


export async function getStaticPaths() {

    const articles = await getAllArticles();

    return articles.map((article) => ({

        params: {

            slug: article.id

        }

    }));

}


const { slug } = Astro.params;

const article = await getArticleBySlug(slug!);

if (!article) {

    throw new Error("Article not found.");

}


const allArticles = await getAllArticles();

const relatedArticles = getRelatedArticles(
    article,
    allArticles
);


const {

    Content,

    headings

} = await render(article);
---

<ArticleLayout

    title={article.data.title}

    description={article.data.description}

    socialImage={article.data.socialImage}

    category={article.data.category}

    readingTime={article.readingTime}

    updated={article.formattedDate}

    publishDate={article.data.publishDate}

    updatedDate={article.data.updatedDate}

    author={article.data.author}

    summary={article.data.summary}

    headings={headings}

    technology={article.data.technology}

    references={article.data.references}

    relatedArticles={relatedArticles}

>

    <Content />

</ArticleLayout>