---
/**
 * ==========================================================
 * Support Engineering Weekly — Episode Page
 * ==========================================================
 */

import PodcastEpisodeLayout
    from "../../layouts/PodcastEpisodeLayout.astro";

import {
    getAllPodcastEpisodes
} from "../../lib/podcast";

import {
    getArticleBySlug
} from "../../lib/articles";


export async function getStaticPaths() {

    const episodes =
        await getAllPodcastEpisodes();

    const orderedEpisodes =
        [...episodes].sort(
            (a, b) =>
                (a.data.season ?? 1) -
                (b.data.season ?? 1) ||
                a.data.episodeNumber -
                b.data.episodeNumber
        );

    return Promise.all(

        episodes.map(
            async (episode) => {

                const currentIndex =
                    orderedEpisodes.findIndex(
                        (item) =>
                            item.id === episode.id
                    );

                const previousEntry =
                    currentIndex > 0
                        ? orderedEpisodes[
                            currentIndex - 1
                        ]
                        : null;


                const nextEntry =
                    currentIndex >= 0 &&
                    currentIndex <
                        orderedEpisodes.length - 1
                        ? orderedEpisodes[
                            currentIndex + 1
                        ]
                        : null;


                const previousEpisode =
                    previousEntry
                        ? {

                            id:
                                previousEntry.id,

                            episodeNumber:
                                previousEntry.data.episodeNumber,

                            title:
                                previousEntry.data.title

                        }
                        : null;


                const nextEpisode =
                    nextEntry
                        ? {

                            id:
                                nextEntry.id,

                            episodeNumber:
                                nextEntry.data.episodeNumber,

                            title:
                                nextEntry.data.title

                        }
                        : null;

                const relatedArticles =
                    await Promise.all(

                        episode.data.relatedArticles.map(
                            async (articleId) => {

                                const article =
                                    await getArticleBySlug(
                                        articleId
                                    );

                                if (!article) {

                                    throw new Error(
                                        `Podcast episode "${episode.id}" references related article "${articleId}", but that article does not exist.`
                                    );

                                }

                                return {

                                    id:
                                        article.id,

                                    title:
                                        article.data.title,

                                    description:
                                        article.data.description

                                };

                            }
                        )

                    );


                return {

                    params: {

                        slug:
                            episode.id

                    },

                    props: {

                        episode,

                        relatedArticles,

                        previousEpisode,

                        nextEpisode

                    }

                };

            }
        )

    );

}


const {

    episode,

    relatedArticles,

    previousEpisode,

    nextEpisode

} = Astro.props;

---

<PodcastEpisodeLayout

    episodeNumber={
        episode.data.episodeNumber
    }

    season={
        episode.data.season
    }

    title={
        episode.data.title
    }

    artwork={
        episode.data.artwork
    }

    description={
        episode.data.description
    }

    publishDate={
        episode.data.publishDate
    }

    duration={
        episode.data.audio.duration
    }

    audioUrl={
        episode.data.audio.url
    }

    audioMimeType={
        episode.data.audio.mimeType
    }

    chapters={
        episode.data.chapters
    }

    relatedArticles={
        relatedArticles
    }

    transcript={
        episode.data.transcript
    }

    captions={
        episode.data.captions
    }

    transcriptFile={
        episode.data.transcriptFile
    }

    previousEpisode={
        previousEpisode
    }

    nextEpisode={
        nextEpisode
    }

/>